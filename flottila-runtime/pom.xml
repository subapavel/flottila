<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flottila</groupId>
    <artifactId>flottila</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>flottila-runtime</artifactId>
  <packaging>jar</packaging>
  <name>Flottila :: runtime</name>
  <description>Vert.x bootstrap, endpoint verticles, Postgres/Kafka/Valkey/S3/ClickHouse implementations, admin API.</description>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <!-- deploy/postgres is the single source of the migrations: ops apply them by file, the runtime from the classpath -->
      <resource>
        <directory>${project.basedir}/../deploy/postgres</directory>
        <targetPath>db/migration</targetPath>
        <includes><include>V*.sql</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- *HeapTest / *HeapIT run in their own JVM with a heap far below the body they stream: a store that holds the
             body at once fails with OutOfMemoryError, deterministically, instead of a GC heuristic deciding (P1-01 review). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes><exclude>**/*HeapTest.java</exclude></excludes>
        </configuration>
        <executions>
          <execution>
            <id>heap-bounded</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <excludes><exclude>none</exclude></excludes>
              <includes><include>**/*HeapTest.java</include></includes>
              <argLine>@{argLine} -Xmx48m</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- MainProcessIT runs Main in a JVM of its own with the JaCoCo agent writing jacoco-main-process.exec (P1-09d3): merged
             with the tests' jacoco.exec so the report and the floors count Main's lines. The merge skips a file that is absent
             (no -Pit run) and writes nothing when neither exists; the report then skips as it does without data. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>merge-main-process</id>
            <phase>post-integration-test</phase>
            <goals><goal>merge</goal></goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco.exec</include>
                    <include>jacoco-main-process.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
            </configuration>
          </execution>
          <execution>
            <id>check-floors</id>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-pg-client</artifactId>
    </dependency>
    <!-- the admin API's Router (D-057 a); version from vertx-stack-depchain, EPL-2.0 / Apache-2.0 (vertx-web-5.1.10.pom) -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the node (F-4): runtime.node validates packages with the schemas; runtime.Main, and no other runtime class
         (archtest), wires the shipped http component, the xslt steps with the xpath language and the xsd step.
         Components and steps depend on api only, so this is no reactor cycle. -->
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-schemas</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-step-xslt</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-step-validate</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-component-http</artifactId>
    </dependency>
    <!-- schema migrations at start (D-034): Flyway community + its Postgres module; Flyway needs JDBC, so the
         driver is a runtime dependency for this one purpose — everything else goes through the Vert.x client -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- *IT classes run under -Pit against Testcontainers Postgres -->
    <dependency>
      <!-- S3 tier: the synchronous S3 client over the JDK's HttpURLConnection; blocking calls run on the message's virtual thread -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion>
        <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- S3 API for the tier's IT: LocalStack (Apache-2.0 image) through the official module (MIT) -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- the heap-bounded IT needs Docker like every IT: only under -Pit, as the parent binds failsafe -->
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <excludes><exclude>**/*HeapIT.java</exclude></excludes>
            </configuration>
            <executions>
              <execution>
                <id>heap-bounded-it</id>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                <configuration>
                  <excludes><exclude>none</exclude></excludes>
                  <includes><include>**/*HeapIT.java</include></includes>
                  <argLine>@{argLine} -Xmx96m</argLine>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
