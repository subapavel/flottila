<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flottila</groupId>
    <artifactId>flottila</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>flottila-runtime</artifactId>
  <packaging>jar</packaging>
  <name>Flottila :: runtime</name>
  <description>Vert.x bootstrap, endpoint verticles, Postgres/Kafka/Valkey/S3/ClickHouse implementations, admin API.</description>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <!-- deploy/postgres is the single source of the migrations: ops apply them by file, the runtime from the classpath -->
      <resource>
        <directory>${project.basedir}/../deploy/postgres</directory>
        <targetPath>db/migration</targetPath>
        <includes><include>V*.sql</include></includes>
      </resource>
    </resources>
  </build>

  <dependencies>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-pg-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- schema migrations at start (D-034): Flyway community + its Postgres module; Flyway needs JDBC, so the
         driver is a runtime dependency for this one purpose — everything else goes through the Vert.x client -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- *IT classes run under -Pit against Testcontainers Postgres -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
