<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flottila</groupId>
    <artifactId>flottila</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>flottila-runtime</artifactId>
  <packaging>jar</packaging>
  <name>Flottila :: runtime</name>
  <description>Vert.x bootstrap, endpoint verticles, Postgres/Kafka/Valkey/S3/ClickHouse implementations, admin API.</description>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <!-- deploy/postgres is the single source of the migrations: ops apply them by file, the runtime from the classpath -->
      <resource>
        <directory>${project.basedir}/../deploy/postgres</directory>
        <targetPath>db/migration</targetPath>
        <includes><include>V*.sql</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- *HeapTest / *HeapIT run in their own JVM with a heap far below the body they stream: a store that holds the
             body at once fails with OutOfMemoryError, deterministically, instead of a GC heuristic deciding (P1-01 review). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes><exclude>**/*HeapTest.java</exclude></excludes>
        </configuration>
        <executions>
          <execution>
            <id>heap-bounded</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <excludes><exclude>none</exclude></excludes>
              <includes><include>**/*HeapTest.java</include></includes>
              <argLine>@{argLine} -Xmx48m</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-pg-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the milestone-1 flow end to end (P1-03): the demo package's files through the schema loader, the xslt step and the
         builder, in the fake Runtime -->
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-schemas</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-step-xslt</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flottila</groupId>
      <artifactId>flottila-step-validate</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- GATE check 3 end to end: the demo flow behind the real http component (P1-06) -->
      <groupId>io.flottila</groupId>
      <artifactId>flottila-component-http</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- schema migrations at start (D-034): Flyway community + its Postgres module; Flyway needs JDBC, so the
         driver is a runtime dependency for this one purpose — everything else goes through the Vert.x client -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- *IT classes run under -Pit against Testcontainers Postgres -->
    <dependency>
      <!-- S3 tier: the synchronous S3 client over the JDK's HttpURLConnection; blocking calls run on the message's virtual thread -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion>
        <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- S3 API for the tier's IT: LocalStack (Apache-2.0 image) through the official module (MIT) -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- the heap-bounded IT needs Docker like every IT: only under -Pit, as the parent binds failsafe -->
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <excludes><exclude>**/*HeapIT.java</exclude></excludes>
            </configuration>
            <executions>
              <execution>
                <id>heap-bounded-it</id>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                <configuration>
                  <excludes><exclude>none</exclude></excludes>
                  <includes><include>**/*HeapIT.java</include></includes>
                  <argLine>@{argLine} -Xmx96m</argLine>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
