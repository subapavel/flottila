+                "the deploy is refused");
+    }
+
+    DeployedPackage deployed(PackageDraft p) throws Exception {
+        return OnVirtualThread.call(() -> deployments.deploy("shop", Optional.empty(), p.zipTo(archives))).pkg();
+    }
+
