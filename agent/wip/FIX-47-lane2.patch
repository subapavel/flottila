+                .put("routes", new JsonArray().add(new JsonObject().put("when", "true()").put("set", "a"))).put("otherwise", "b");
+    }
+
+    /** {@code to} step {@code send}: reads {@code byProp}, each of its values {@code a} and {@code b} to the out endpoint {@code partner}. */
+    static JsonObject toByProp(String byProp) {
