+        assertEquals(List.of(), queue.claims(), "no worker polls");
+    }
+
+    /** The one problem line, which names the flow, the step and the prop, each quoted. */
+    static void namesFlowStepAndProp(DeployRefusedException refused, String flow, String step, String prop) {
+        assertEquals(Kind.INVALID, refused.kind(), "422: " + refused.error() + " " + refused.problems());
+        assertEquals(1, refused.problems().size(), "one line, for the one step that names a reserved prop: " + refused.problems());
+        String line = refused.problems().getFirst();
+        assertTrue(line.contains("flow '" + flow + "'"), "the line names the flow: " + line);
+        assertTrue(line.contains("'" + step + "'"), "the line names the step: " + line);
+        assertTrue(line.contains("'" + prop + "'"), "the line names the prop: " + line);
+    }
+
+    // --- A2, A5: the row's case
+
+    /**
+     * The row's case: {@code route} with {@code prop: attempt}. Refused at deploy, 422, one line naming {@code attempt}, flow
+     * {@code audit} and step {@code decide}; no flow is built and no consumer made, so no message reaches {@code Envelope.nextKey}
+     * with a String under {@code attempt}.
+     */
+    @Test
+    void aRouteWritingAttemptIsRefused422NamingThePropTheFlowAndTheStep() {
+        DeployRefusedException refused = refused(shop(Map.of("audit", new JsonArray().add(route("attempt")).add(PackageDraft.toPartner().getJsonObject(0)))));
+
+        namesFlowStepAndProp(refused, "audit", "decide", "attempt");
+        nothingDeployed();
+    }
+
+    // --- A1, A2: every reserved name, in every step kind that takes a prop name
+
+    /** {@code route} with {@code prop:} naming each reserved prop, then a {@code to} by a prop of the flow's own: one line, naming the prop and {@code decide}. */
+    @ParameterizedTest(name = "route prop: {0}")
+    @ValueSource(strings = {"attempt", "replayOf", "splitParentId", "splitIndex", "splitTotal"})
+    void aRouteWritingAReservedPropIsRefused(String reserved) {
