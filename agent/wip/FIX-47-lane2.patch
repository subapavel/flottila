+        flows.forEach((id, steps) -> p.endpoint(id + "-in", "in", new JsonObject().put("path", "/" + id)).flow(id, "1.0.0", "at-least-once", id + "-in", 1024, steps));
+        return p;
+    }
+
+    /** {@code audit} alone, its steps a route on {@code routed} then a {@code to} by {@code read}. */
+    static PackageDraft audit(String routed, String read) {
+        return shop(Map.of("audit", new JsonArray().add(route(routed)).add(toByProp(read))));
+    }
+
+    DeployRefusedException refused(PackageDraft p) {
