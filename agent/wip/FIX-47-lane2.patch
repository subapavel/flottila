+package io.flottila.cli;
+
+import io.flottila.cli.CliRuns.Ran;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static io.flottila.cli.CliRuns.DEMO;
+import static io.flottila.cli.CliRuns.run;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * FIX-47 (D-140), A3: {@code flottila validate} and {@code flottila test} refuse a flow that names a reserved prop (the names the
+ * platform writes on an envelope: {@code attempt}, {@code replayOf}, {@code splitParentId}, {@code splitIndex},
+ * {@code splitTotal}) with the deploy's own problem lines — the CLI runs the node's dry build ({@code Deployments.validate}), so it
+ * prints what a deploy answers with 422. The package: the demo with {@code invoice-sync}'s route ({@code prop:}) and to
+ * ({@code byProp:}) moved from {@code PARTNER} to the reserved {@code attempt}, the two steps renamed {@code pickPartner} and
+ * {@code sendOn} so each line's step name cannot be matched by anything else on it. Before FIX-47 validate passed it and every
+ * case of the flow failed at run time (a String under the Integer {@code attempt}).
+ */
+class ReservedPropCommandTest {
+
+    @TempDir Path tmp;
+
+    /** The demo at {@code tmp/<dir>}, invoice-sync's route and to on {@code prop}, the route step {@code pickPartner}, the to step {@code sendOn}. */
+    Path demoRoutingOn(String prop, String dir) throws IOException {
+        Path copy = CliRuns.copy(DEMO, tmp.resolve(dir));
+        Map<String, String> rewrites = new LinkedHashMap<>();
+        rewrites.put("    name: route\n", "    name: pickPartner\n");
+        rewrites.put("    prop: PARTNER\n", "    prop: " + prop + "\n");
+        rewrites.put("    name: partner\n", "    name: sendOn\n");
+        rewrites.put("    byProp: PARTNER\n", "    byProp: " + prop + "\n");
+        CliRuns.rewrite(copy.resolve("flows/invoice-sync.yaml"), rewrites);
+        return copy;
+    }
+
+    /** The two problem lines of a route and a to on {@code attempt}: each names invoice-sync, its step and {@code 'attempt'}. */
+    static void twoLinesNamingAttempt(Ran ran) {
+        List<String> problems = ran.problems();
+        assertEquals(2, problems.size(), "one line per step naming the reserved prop: " + ran);
+        assertTrue(problems.stream().anyMatch(l -> l.contains("flow 'invoice-sync'") && l.contains("'pickPartner'") && l.contains("'attempt'")),
+                "a line names invoice-sync, the route step pickPartner and attempt: " + ran);
+        assertTrue(problems.stream().anyMatch(l -> l.contains("flow 'invoice-sync'") && l.contains("'sendOn'") && l.contains("'attempt'")),
+                "a line names invoice-sync, the to step sendOn and attempt: " + ran);
+    }
+
+    /** {@code validate}: the tree, then one problem line per step naming {@code attempt}, exit 1. */
+    @Test
+    void validateRefusesARouteAndAToOnAttemptNamingThePropTheFlowAndEachStep() throws IOException {
+        Ran ran = run("validate", demoRoutingOn("attempt", "reserved").toString());
+
+        assertEquals(1, ran.exit(), ran.toString());
+        twoLinesNamingAttempt(ran);
+    }
+
+    /** {@code test} refuses the same package before any case runs, with exactly the lines validate prints, exit 1. */
+    @Test
+    @Timeout(value = 120, threadMode = Timeout.ThreadMode.SEPARATE_THREAD)
+    void testRefusesTheSamePackageWithValidatesLinesAndRunsNoCase() throws IOException {
+        Path dir = demoRoutingOn("attempt", "reserved");
+        Ran validated = run("validate", dir.toString());
+
+        Ran tested = run("test", dir.toString());
+
+        assertEquals(1, tested.exit(), tested.toString());
+        twoLinesNamingAttempt(tested);
+        assertEquals(validated.problems(), tested.problems(), "the same check, the same lines: validate " + validated + "\ntest " + tested);
+        assertTrue(tested.outLines().stream().noneMatch(TestCommandTest::caseLine), "no case ran: " + tested);
+    }
+
+    /** A4: {@code attempts} only looks like the reserved {@code attempt}: the same rewrite with it validates, exit 0, no problem line. */
+    @Test
+    void validateAcceptsAPropThatOnlyLooksReserved() throws IOException {
+        Ran ran = run("validate", demoRoutingOn("attempts", "lookalike").toString());
+
+        assertEquals(0, ran.exit(), ran.toString());
+        assertEquals(List.of(), ran.problems(), ran.toString());
+    }
+}
