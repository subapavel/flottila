+ * step naming the prop, the flow and the step, nothing deployed. The reserved set is exact, as the runtime writes it:
+ * {@code attempt} (the worker's rerun, D-066), {@code replayOf} (a replay), {@code splitParentId}, {@code splitIndex} and
+ * {@code splitTotal} (a split's children). The steps of the flow schema that take a prop name are {@code route} ({@code prop:},
+ * written) and {@code to} ({@code byProp:}, read). A name that merely starts like a reserved one ({@code attempts},
+ * {@code splitter}, {@code split}) is the flow's own and deploys: the set is names, not prefixes. Before FIX-47 a
+ * {@code route} with {@code prop: attempt} deployed and every message failed at {@code Envelope.nextKey} (a String read as the
+ * Integer attempt); refused at deploy, no consumer exists for such a message to reach.
+ *
+ * <p>Wired as {@link DeploymentsQueueTest} — the {@link Doors} component, the in-memory store and DLQ, a {@link CountingQueue},
+ * the fake clock driving every timer — with the shipped expression languages ({@link Main#shipped()}: xpath), so a route's
+ * {@code when} compiles and only the prop name can refuse it.
+ */
+class DeploymentsReservedPropTest {
+
+    @TempDir Path tmp;
+    Path archives;
+
+    final FakeRuntime rt = FakeRuntime.create();
+    final Doors doors = new Doors();
+    final InMemoryMessageStore messages = new InMemoryMessageStore();
+    final InMemoryDlq dlq = new InMemoryDlq();
+    TracingTimer timer;
+    CountingQueue queue;
+    Deployments deployments;
+
+    @BeforeEach
+    void wire() {
+        archives = tmp.resolve("archives");
+        timer = new TracingTimer(rt.timer());
+        queue = new CountingQueue(rt.clock());
+        Map<String, String> env = new HashMap<>();
+        env.put("FLOTTILA_ENV", "dev");
+        env.put("FLOTTILA_NODE_ID", DeploymentsTest.NODE);
+        env.put("FLOTTILA_DATA_DIR", tmp.resolve("data").toString());
+        env.put("FLOTTILA_STOP_DEADLINE", DeploymentsTest.STOP_DEADLINE.toString());
+        env.put("FLOTTILA_BLOB_DURABLE_MAX", Long.toString(DeploymentsTest.DURABLE_MAX));
+        env.put("FLOTTILA_MAX_PACKAGE_BYTES", Long.toString(DeploymentsTest.MAX_PACKAGE));
+        Runtime runtime = new Runtime(rt.clock(), timer, rt.ids(), rt.blobs(), rt.hasher(), Map.of(Doors.SCHEME, doors));
+        deployments = new Deployments(NodeConfig.from(env), runtime, Map.of(Doors.SCHEME, doors), rt.clock(), timer, DeploymentsTest.STEPS,
