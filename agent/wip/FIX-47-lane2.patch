+/**
+ * FIX-47 (D-140), restore: a record of the pool whose package names a reserved prop — deployed before FIX-47 refused it — is
+ * refused by the restore's check like any package with problems: listed FAILED with the deploy's own line naming the prop, the
+ * flow and the step, nothing of it started; the node starts all the same (the restore returns) and the clean package beside it
+ * runs. Wired as {@link DeploymentsRestoreTest} (a {@link Ledger} of rows, a {@link Shelf} of archives), with the shipped
+ * expression languages so the route compiles and only its prop can refuse it.
+ */
+class DeploymentsReservedPropRestoreTest {
+
+    static final Instant NOW = Instant.parse("2026-11-14T09:30:00Z");
+
+    @TempDir Path tmp;
+
+    final FakeRuntime rt = FakeRuntime.create().withClockAt(NOW);
+    final Doors doors = new Doors();
+    Ledger records;
+    Shelf shelf;
+    Deployments deployments;
+
+    @BeforeEach
+    void wire() {
+        records = new Ledger(t -> { });
+        shelf = new Shelf(tmp.resolve("bucket"), tmp.resolve("shelf-reads"), t -> { });
+        Map<String, String> env = new HashMap<>();
+        env.put("FLOTTILA_ENV", "dev");
+        env.put("FLOTTILA_NODE_ID", "node-2");
+        env.put("FLOTTILA_DATA_DIR", tmp.resolve("data").toString());
+        env.put("FLOTTILA_STOP_DEADLINE", DeploymentsTest.STOP_DEADLINE.toString());
+        env.put("FLOTTILA_BLOB_DURABLE_MAX", Long.toString(DeploymentsTest.DURABLE_MAX));
+        env.put("FLOTTILA_MAX_PACKAGE_BYTES", Long.toString(DeploymentsTest.MAX_PACKAGE));
+        TracingTimer timer = new TracingTimer(rt.timer());
+        Runtime runtime = new Runtime(rt.clock(), timer, rt.ids(), rt.blobs(), rt.hasher(), Map.of(Doors.SCHEME, doors));
+        deployments = new Deployments(NodeConfig.from(env), runtime, Map.of(Doors.SCHEME, doors), rt.clock(), timer, DeploymentsTest.STEPS,
+                Main.shipped().languages(), new InMemoryMessageStore(), new InMemoryDlq(), new CountingQueue(rt.clock()), () -> 0L, records, shelf);
+    }
+
+    @AfterEach
+    void release() throws Exception {
+        doors.releaseAll();
+        records.releaseAll();
+        OnVirtualThread.call(() -> {
+            deployments.close();
+            return null;
+        });
+    }
+
+    /** A row and an object of the pool for {@code p}, as a node that deployed it leaves them. */
+    void recorded(PackageDraft p) throws Exception {
+        byte[] zip = p.zip();
+        String sha256 = PackageDraft.sha256(zip);
+        Path file = PackageDraft.write(tmp.resolve("uploads"), zip);
+        OnVirtualThread.call(() -> {
+            shelf.put(sha256, file);
+            return null;
+        });
+        records.save(new DeploymentRecord(p.manifest().getString("name"), "1.0.0", Optional.empty(), sha256, NOW, List.of())).await();
+    }
+
+    DeployedPackage pkg(String name) {
+        return deployments.packages().stream().filter(p -> p.name().equals(name)).findFirst().orElseThrow();
+    }
+
+    /**
+     * {@code shop}'s flow {@code audit} routes on {@code attempt} (step {@code decide}); {@code store}'s flow {@code c} names no
+     * reserved prop. The restore returns; shop is FAILED, one of its problems the line naming {@code attempt}, {@code audit} and
+     * {@code decide}, none of its doors made; store runs and accepts.
+     */
+    @Test
+    void aRecordedPackageNamingAReservedPropIsListedFailedAndTheNodeStarts() throws Exception {
+        recorded(DeploymentsReservedPropTest.shop(Map.of("audit",
+                new JsonArray().add(DeploymentsReservedPropTest.route("attempt")).add(DeploymentsReservedPropTest.toByProp("lane")))));
+        PackageDraft store = PackageDraft.of("store", "1.0.0").endpoint("partner", "out", new JsonObject().put("url", "rec://partner"))
+                .endpoint("c-in", "in", new JsonObject().put("path", "/c")).flow("c", "1.0.0", "sync", "c-in", 1024, PackageDraft.toPartner());
+        recorded(store);
+
+        OnVirtualThread.call(() -> {
+            deployments.restore();
+            return null;
+        });
+
+        DeployedPackage shop = pkg("shop");
+        assertEquals(DeployedPackage.State.FAILED, shop.state(), "shop is refused whole: " + shop);
+        assertEquals(List.of(), shop.flows(), "a FAILED package lists no flows: " + shop);
+        assertTrue(shop.problems().stream().anyMatch(l -> l.contains("flow 'audit'") && l.contains("'decide'") && l.contains("'attempt'")),
+                "a problem line names audit, decide and attempt: " + shop.problems());
+        assertTrue(doors.doors().stream().noneMatch(d -> d.flow().startsWith("shop/")), "no door of shop: " + doors.events());
+        assertEquals(DeployedPackage.State.RUNNING, pkg("store").state(), "store runs: " + pkg("store"));
+        Envelope e = rt.ingress("store/c", Headers.empty(), Buffer.buffer("<order/>"));
+        Ack answer = within(doors.door("store/c").deliver(e), "c's answer");
+        assertTrue(answer instanceof Ack.Reply, "c serves: " + answer);
+    }
+}
