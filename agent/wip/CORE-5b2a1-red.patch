+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.stream.Stream;
+
+import static io.flottila.runtime.journal.JournalFixture.KEY;
+import static io.flottila.runtime.journal.JournalFixture.START;
+import static io.flottila.runtime.journal.JournalFixture.keys;
+import static io.flottila.runtime.journal.JournalFixture.live;
+import static io.flottila.runtime.journal.JournalFixture.onVirtual;
+import static io.flottila.runtime.journal.JournalFixture.parked;
+import static io.flottila.runtime.journal.JournalFixture.record;
+import static io.flottila.runtime.journal.JournalFixture.settings;
+import static io.flottila.runtime.journal.JournalFixture.until;
+import static io.flottila.runtime.journal.ScriptedReplication.handOut;
+import static io.flottila.runtime.journal.ScriptedReplication.segmentFile;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * The ACK order of the two-copy journal (CORE-5b2a1 T12): any interleaving of appends, forces (a gate on every segment-file
+ * force, {@link GatedFiles}), {@code copied}, {@code single}, {@code failed} and {@code pair} completes the appends as a
+ * prefix in journal position order — a completion, success or failure, never runs while an earlier append is neither
+ * complete nor acknowledgeable — no append succeeds before it is forced and (its segment is single or its copy reaches its
+ * end), a failure carries the loss a {@code failed} named its segment with, and at quiescence every byte left
+ * {@code FLOTTILA_JOURNAL_PENDING_BYTES} (an append of exactly the bound is taken at once).
+ *
+ * <p>The checks run in each completion's listener against what the driver did, each flag set <em>before</em> its call: a
+ * listener that sees a condition unmet saw a completion that came before the call that could have allowed it. The driver is
+ * one thread, so the order of {@code pair} and of each segment's first reservation is known exactly.
+ *
+ * <p>jqwik runs no {@code @BeforeEach}/{@code @AfterEach} for a property: every try builds and removes its own state. The
+ * class is {@code JournalAckOrderPropertiesTest}, not the spec's {@code JournalAckOrderProperties}: Surefire's default
+ * includes would never run a class named {@code *Properties}.
+ */
+class JournalAckOrderPropertiesTest {
+
+    static final int RECORD_MAX = 8192;
+    /** PENDING_BYTES = RECORD_MAX: the quiescence probe of exactly this many encoded bytes is taken only when nothing is pending. */
+    static final int PENDING = 8192;
+    /** At most this many appends a try (each at most 64 + 3 + 300 bytes): 6606 bytes, under PENDING, so no append ever waits. */
+    static final int MAX_APPENDS = 18;
+    static final Duration APPEND_WAIT = Duration.ofSeconds(2);
+
+    sealed interface Step permits Append, Shut, Open, Copy, Single, Fail, Pair { }
+
+    record Append(int size) implements Step { }
+
+    /** Segment-file forces wait from now on. */
+    record Shut() implements Step { }
+
+    /** Segment-file forces go on. */
+    record Open() implements Step { }
+
+    /** {@code copied} of the {@code segment}-th segment holding records, up to the end of its {@code record}-th (one byte short). */
+    record Copy(int segment, int record, boolean shortOfIt) implements Step { }
+
+    record Single(int segment) implements Step { }
+
+    record Fail(int segment) implements Step { }
+
+    record Pair() implements Step { }
+
+    @Provide
+    Arbitrary<List<Step>> runs() {
+        Arbitrary<Step> append = Arbitraries.integers().between(0, 300).map(Append::new);
+        Arbitrary<Step> shut = Arbitraries.just(new Shut());
+        Arbitrary<Step> open = Arbitraries.just(new Open());
+        Arbitrary<Step> copy = Combinators.combine(Arbitraries.integers().between(0, 7), Arbitraries.integers().between(0, 7),
+                Arbitraries.of(false, false, false, true)).as(Copy::new);
+        Arbitrary<Step> single = Arbitraries.integers().between(0, 7).map(Single::new);
+        Arbitrary<Step> fail = Arbitraries.integers().between(0, 7).map(Fail::new);
+        Arbitrary<Step> pair = Arbitraries.just(new Pair());
+        return Arbitraries.frequencyOf(Tuple.of(6, append), Tuple.of(2, shut), Tuple.of(2, open), Tuple.of(4, copy),
+                Tuple.of(1, single), Tuple.of(1, fail), Tuple.of(3, pair)).list().ofMinSize(1).ofMaxSize(40);
+    }
+
+    @Property(tries = 100)
+    void completionsArePositionOrderedAndNeedForcedAndACopy(@ForAll("runs") List<Step> run) throws Exception {
+        Path dir = Files.createTempDirectory("journal-ack-order");
+        try {
+            new Run(dir).go(run);
+        } finally {
+            try (Stream<Path> walk = Files.walk(dir)) {
+                for (Path p : walk.sorted(Comparator.reverseOrder()).toList()) Files.delete(p);
+            }
+        }
+    }
+
+    /** One try: a journal, its gate, its scripted Replication, and what the driver did. */
+    private static final class Run {
+        private record Rec(int index, String id, JournalRef ref, Future<Void> forced) {
+            long n() { return ref.segment(); }
+
+            long end() { return ref.position() + ref.length(); }
+        }
+
+        private final Path dir;
+        private final FakeClock clock = FakeClock.at(START);
+        private final LoggedTimer timer = new LoggedTimer(new FakeTimer(clock));
+        private final GatedFiles files = new GatedFiles();
+        private final ScriptedReplication repl = new ScriptedReplication();
+        private Journal journal;
+        private Journal.Copies copies;
+
+        private final List<Rec> recs = new CopyOnWriteArrayList<>();
+        private final Set<Long> paired = ConcurrentHashMap.newKeySet();
+        private final Map<Long, Long> copiedTo = new ConcurrentHashMap<>();
+        private final Set<Long> singled = ConcurrentHashMap.newKeySet();
+        private final Map<Long, Set<Throwable>> lostWith = new ConcurrentHashMap<>();
+        private final List<String> violations = new CopyOnWriteArrayList<>();
+        private final AtomicInteger checked = new AtomicInteger();
+        private final List<String> done = new ArrayList<>();   // the steps applied, for the failure message
+
+        Run(Path dir) { this.dir = dir; }
+
+        void go(List<Step> run) throws Exception {
+            JournalConfig config = settings(dir).recordMax(RECORD_MAX).pendingBytes(PENDING).appendWait(APPEND_WAIT).segmentRecords(3)
+                    .segmentAge(Duration.ofHours(1)).config();
+            journal = Journal.open(config, clock, timer, keys(KEY), files);
+            try {
+                copies = journal.replicate(repl);
+                for (Step s : run) apply(s);
+                quiesce();
+                assertEquals(List.of(), violations, "steps " + done);
+                assertEquals(List.of(), repl.errors);
+                probe();
+            } finally {
+                files.open();
+                journal.close();
+            }
+        }
+
+        private List<Long> segments() {
+            Set<Long> s = new TreeSet<>();
+            for (Rec r : recs) s.add(r.n());
+            return new ArrayList<>(s);
+        }
+
+        private List<Rec> of(long n) {
+            return recs.stream().filter(r -> r.n() == n).toList();
+        }
+
+        private void apply(Step step) {
+            switch (step) {
+                case Append a -> {
+                    if (recs.size() >= MAX_APPENDS) return;
+                    String id = "r" + recs.size();
+                    Journal.Appended x = journal.append(record(id, a.size()), live());
+                    Rec r = new Rec(recs.size(), id, x.ref(), x.forced());
+                    recs.add(r);
+                    done.add("append " + id + " at " + x.ref());
+                    x.forced().onComplete(ar -> check(r, ar));
+                }
+                case Shut s -> {
+                    files.shut();
+                    done.add("shut");
+                }
+                case Open o -> {
+                    files.open();
+                    done.add("open");
+                }
+                case Copy c -> {
+                    List<Long> segs = segments();
+                    if (segs.isEmpty()) return;
+                    long n = segs.get(c.segment() % segs.size());
+                    List<Rec> of = of(n);
+                    long to = of.get(c.record() % of.size()).end() - (c.shortOfIt() ? 1 : 0);
+                    if (to <= copiedTo.getOrDefault(n, 0L)) return;
+                    copiedTo.put(n, to);
+                    done.add("copied(" + n + ", " + to + ")");
+                    copies.copied(n, to);
+                }
+                case Single g -> {
+                    List<Long> segs = segments();
+                    if (segs.isEmpty()) return;
+                    long n = segs.get(g.segment() % segs.size());
+                    singled.add(n);
+                    done.add("single(" + n + ")");
+                    copies.single(Set.of(n));
+                }
+                case Fail f -> {
+                    List<Long> segs = segments();
+                    if (segs.isEmpty()) return;
+                    long n = segs.get(f.segment() % segs.size());
+                    JournalPeerLostException e = new JournalPeerLostException("the peer copy of segment " + n + " is lost (property)");
+                    lostWith.computeIfAbsent(n, k -> ConcurrentHashMap.newKeySet()).add(e);
+                    done.add("failed(" + n + ")");
+                    copies.failed(Set.of(n), e);
+                }
+                case Pair p -> {
+                    List<Handed> handed = handOut(copies);
+                    for (Handed h : handed) {
+                        if (!of(h.n()).isEmpty()) violations.add("pair handed out segment " + h.n() + ", which holds a record");
+                        else paired.add(h.n());
+                    }
+                    done.add("pair → " + handed.stream().map(Handed::n).toList());
+                }
+            }
+        }
+
+        private boolean durable(Rec r) {
+            return files.durable(segmentFile(dir, r.n())) >= r.end();
+        }
+
+        private boolean acknowledgeable(Rec r) {
+            long n = r.n();
+            return !paired.contains(n) || singled.contains(n) || copiedTo.getOrDefault(n, 0L) >= r.end();
+        }
+
+        private void check(Rec r, AsyncResult<Void> ar) {
+            try {
+                if (ar.succeeded()) {
+                    if (!durable(r)) violations.add(r.id() + " " + r.ref() + " succeeded before it was forced");
+                    if (!acknowledgeable(r)) {
+                        violations.add(r.id() + " " + r.ref() + " succeeded while paired, not single and copied only to " + copiedTo.get(r.n()));
+                    }
+                } else if (!lostWith.getOrDefault(r.n(), Set.of()).contains(ar.cause())) {
+                    violations.add(r.id() + " " + r.ref() + " failed with " + ar.cause() + ", not a loss failed() named its segment with");
+                }
+                for (Rec q : recs) {
+                    if (q.index() >= r.index()) break;
+                    boolean eligible = lostWith.containsKey(q.n()) || (durable(q) && acknowledgeable(q));
+                    if (!q.forced().isComplete() && !eligible) {
+                        violations.add(r.id() + " completed while the earlier " + q.id() + " " + q.ref() + " was neither complete nor acknowledgeable");
+                    }
+                }
+            } finally {
+                checked.incrementAndGet();
+            }
+        }
+
+        /** Forces go on, every paired segment is copied to its last record's end: every append completes. */
+        private void quiesce() {
+            files.open();
+            for (long n : segments()) {
+                if (!paired.contains(n)) continue;
+                long to = of(n).getLast().end();
+                if (to > copiedTo.getOrDefault(n, 0L)) {
+                    copiedTo.put(n, to);
+                    done.add("copied(" + n + ", " + to + ") at quiescence");
+                    copies.copied(n, to);
+                }
+            }
+            for (Rec r : recs) until(r.forced()::isComplete, () -> r.id() + " " + r.ref() + " completes at quiescence; steps " + done);
+            until(() -> checked.get() == recs.size(), () -> "every listener ran");
+            for (Rec r : recs) {
+                if (!lostWith.containsKey(r.n())) {
+                    assertTrue(r.forced().succeeded(), r.id() + " of a segment no failed() named succeeds: " + r.forced().cause() + "; steps " + done);
+                }
+            }
+        }
+
+        /** Nothing is pending: an append of exactly PENDING encoded bytes (64 + "probe" 5 + 8123) is taken without a wait. */
+        private void probe() throws Exception {
+            int waits = timer.withDelay(APPEND_WAIT).size();
+            JournalRecord full = new JournalRecord("probe", 0, "in", KEY, new byte[PENDING - 64 - 5]);
+            Outcome<Journal.Appended> o = onVirtual(() -> journal.append(full, live()));
+            until(() -> o.done() || (parked(o.thread()) && timer.withDelay(APPEND_WAIT).size() > waits),
+                    () -> "the probe returns or waits for room; timer " + timer.log());
+            assertTrue(o.done(), "at quiescence bytes are still pending under FLOTTILA_JOURNAL_PENDING_BYTES: the probe waits; steps " + done);
+            assertEquals(PENDING, o.join().ref().length(), "the probe is exactly PENDING bytes");
+        }
+    }
+}
