+    /** A record whose encoded length is exactly {@code encoded} (an ASCII id, part "in", one chunk). */
+    private static JournalRecord sized(String id, int encoded) {
+        return new JournalRecord(id, 0, "in", KEY, body(id, encoded - OVERHEAD - id.length()));
+    }
+
+    private static long end(Journal.Appended a) {
+        return a.ref().position() + a.ref().length();
+    }
+
+    /**
+     * Waits until {@code id}'s force returned and the writer took the round after it (a follower's write entered): the round
+     * that forced {@code id} is over, whatever it decided is decided. Returns the follower.
+     */
+    private static Journal.Appended afterTheRoundOf(World w, String id, String follower) {
+        until(() -> w.files.forcedPast(id), () -> id + " is forced: " + w.files.describe());
+        Journal.Appended f = w.journal.append(record(follower, 100), live());
+        until(() -> w.files.firstWrite(follower) != null, () -> "the writer takes the round after " + id + "'s: " + w.files.describe());
+        return f;
+    }
+
+    private static JournalPeerLostException lost(String what) {
+        return new JournalPeerLostException("the peer copy of " + what + " is lost (test)");
+    }
+
+    /** Waits until {@code o} returned or parks in an append wait armed on the fake timer after {@code waitsBefore}. */
+    private void untilTakenOrWaiting(Outcome<Journal.Appended> o, int waitsBefore, String what) {
+        until(() -> o.done() || (parked(o.thread()) && timer.withDelay(WAIT).size() > waitsBefore),
+                () -> what + " returns or waits for room on the fake timer; timer " + timer.log());
+    }
+
+    /** The journal's log lines at INFO or above that speak of single segments (the transition the spec names). */
+    private static List<LogRecord> singleLines(LogCapture log) {
+        return log.records().stream()
+                .filter(r -> r.getLevel().intValue() >= Level.INFO.intValue() && r.getMessage() != null
+                        && r.getMessage().toLowerCase(java.util.Locale.ROOT).contains("single"))
+                .toList();
+    }
