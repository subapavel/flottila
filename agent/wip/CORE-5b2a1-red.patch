+    @ParameterizedTest
+    @EnumSource(Variant.class)
+    void noneIsToday(Variant variant) throws Exception {
+        World w = plain(quiet("none-" + variant).segmentRecords(2).recordMax(8192).pendingBytes(8192));
+        try (LogCapture log = new LogCapture()) {
+            Journal.Copies copies = variant == Variant.WITH_NONE ? w.journal.replicate(Replication.NONE) : null;
+            Hold force = w.files.holdForceAfter("nt-0");
+            Journal.Appended r0 = w.journal.append(sized("nt-0", 5000), live());
+            force.awaitReached();
+            untilParked(force.thread(), "the writer sits in nt-0's held force");
+            Map<String, Boolean> forcedAtCompletion = new ConcurrentHashMap<>();
+            r0.forced().onComplete(ar -> forcedAtCompletion.put("nt-0", w.files.forcedPast("nt-0")));
+            assertFalse(r0.forced().isComplete(), "nothing completes before its force");
+
+            force.release();
+            await(r0.forced());
+            until(() -> forcedAtCompletion.containsKey("nt-0"), () -> "the listener ran");
+            assertEquals(Map.of("nt-0", true), forcedAtCompletion, "the force alone completes a record, as today: no copy is asked for");
+
+            // its 5000 bytes left FLOTTILA_JOURNAL_PENDING_BYTES (8192) with that completion: another 5000 are taken at once
+            Outcome<Journal.Appended> next = onVirtual(() -> w.journal.append(sized("nt-1", 5000), live()));
+            Journal.Appended r1 = next.join();
+            await(r1.forced());
+            assertEquals(r0.ref().segment(), r1.ref().segment(), "segmentRecords 2: nt-1 is the segment's second record");
+            until(() -> indexed(w.journal, r0.ref().segment()), () -> "the segment rolled by count is sealed as today");
+
+            if (copies != null) {
+                assertEquals(0, copies.singleSegments(), "NONE is today: no segment counts as single");
+                assertEquals(0, copies.singleBytes(), "NONE is today: no byte counts as single");
+            }
+            assertEquals(List.of(), singleLines(log), "NONE logs no transition to single: " + log.lines());
+        }
+    }
