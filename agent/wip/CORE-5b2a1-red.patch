+package io.flottila.runtime.journal;
+
+import java.nio.ByteBuffer;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+
+/**
+ * The journal's port to its peer copy, scripted by a case (CORE-5b2a1, Q1: a hand-written fake at the journal's port, no
+ * mocking library). Every hook is recorded with the calling thread and a stamp taken on entry ({@link HeldFiles#now()} when
+ * the case gives one: every file op entered later has a larger sequence number), the bytes it was given copied at once
+ * (through duplicates: the journal's buffers are not moved). A case scripts a reaction per hook; a reaction that throws is
+ * recorded in {@link #errors} (asserted empty by the case), never thrown into the journal's thread.
+ */
+final class ScriptedReplication implements Replication {
+
+    /** The holder every case pairs with. */
+    static final String HOLDER = "node-2";
+
+    record Preopened(long n, Thread thread, long stamp) { }
+
+    record Wrote(long n, long pos, byte[] bytes, Thread thread, long stamp) {
+        long end() { return pos + bytes.length; }
+    }
+
+    record Sealed(long n, long pos, byte[] footer, long end, Thread thread, long stamp) { }
+
+    /** A segment {@link Journal.Copies#pair pair} handed out: its number, its header's bytes and the OPEN length. */
+    record Handed(long n, byte[] header, long length) { }
+
+    final List<Preopened> preopened = new CopyOnWriteArrayList<>();
+    final List<Wrote> wrote = new CopyOnWriteArrayList<>();
+    final List<Sealed> sealed = new CopyOnWriteArrayList<>();
+    /** Reactions run elsewhere that did not return within their bound, or failed: a hook ran under a lock they need. */
+    final List<String> stuck = new CopyOnWriteArrayList<>();
+    /** Reactions that threw on the hook's own thread. */
+    final List<Throwable> errors = new CopyOnWriteArrayList<>();
+
+    private final LongSupplier stamps;
+    volatile Consumer<Preopened> onPreopened = p -> { };
+    volatile Consumer<Wrote> onWrote = w -> { };
+    volatile Consumer<Sealed> onSealed = s -> { };
+
+    ScriptedReplication(LongSupplier stamps) { this.stamps = stamps; }
+
+    ScriptedReplication() { this(() -> 0L); }
+
+    @Override public void preopened(long n) {
+        Preopened p = new Preopened(n, Thread.currentThread(), stamps.getAsLong());
+        preopened.add(p);
+        react(() -> onPreopened.accept(p));
+    }
+
+    @Override public void wrote(long n, long pos, List<ByteBuffer> bytes) {
+        long stamp = stamps.getAsLong();
+        int length = 0;
+        List<byte[]> parts = new ArrayList<>(bytes.size());
+        for (ByteBuffer b : bytes) {
+            ByteBuffer d = b.duplicate();
+            byte[] part = new byte[d.remaining()];
+            d.get(part);
+            parts.add(part);
+            length += part.length;
+        }
+        byte[] all = new byte[length];
+        int at = 0;
+        for (byte[] part : parts) {
+            System.arraycopy(part, 0, all, at, part.length);
+            at += part.length;
+        }
+        Wrote w = new Wrote(n, pos, all, Thread.currentThread(), stamp);
+        wrote.add(w);
+        react(() -> onWrote.accept(w));
+    }
+
+    @Override public void sealed(long n, long pos, ByteBuffer footer, long end) {
+        long stamp = stamps.getAsLong();
+        ByteBuffer d = footer.duplicate();
+        byte[] f = new byte[d.remaining()];
+        d.get(f);
+        Sealed s = new Sealed(n, pos, f, end, Thread.currentThread(), stamp);
+        sealed.add(s);
+        react(() -> onSealed.accept(s));
+    }
+
+    private void react(Runnable reaction) {
+        try {
+            reaction.run();
+        } catch (RuntimeException | Error e) {
+            errors.add(e);
+        }
+    }
+
+    List<Wrote> wroteOf(long n) { return wrote.stream().filter(w -> w.n() == n).toList(); }
+
+    List<Sealed> sealedOf(long n) { return sealed.stream().filter(s -> s.n() == n).toList(); }
+
+    Set<Long> preopenedNumbers() {
+        Set<Long> s = new TreeSet<>();
+        for (Preopened p : preopened) s.add(p.n());
+        return s;
+    }
+
+    /**
+     * Runs {@code reaction} on a virtual thread of its own and waits for it at most {@code bound} (a failure detector, never a
+     * timing): one that does not return is recorded in {@link #stuck} and left behind, so a hook called under a lock the
+     * reaction takes fails the case instead of hanging it.
+     */
+    void elsewhere(String what, Duration bound, Callable<?> reaction) {
+        CompletableFuture<Object> done = new CompletableFuture<>();
+        Thread.ofVirtual().name("hook-reaction").start(() -> {
+            try {
+                done.complete(reaction.call());
+            } catch (Throwable t) {
+                done.completeExceptionally(t);
+            }
+        });
+        try {
+            done.get(bound.toMillis(), TimeUnit.MILLISECONDS);
+        } catch (TimeoutException e) {
+            stuck.add(what + " from another thread did not return within " + bound + ": the hook's caller holds a lock it takes");
+        } catch (ExecutionException e) {
+            stuck.add(what + " from another thread failed: " + e.getCause());
+            errors.add(e.getCause());
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            stuck.add(what + " was interrupted");
+        }
+    }
+
+    /** One {@code pair} call: what it handed out, its header bytes copied. */
+    static List<Handed> handOut(Journal.Copies copies) {
+        List<Handed> out = new ArrayList<>();
+        for (var p : copies.pair(HOLDER)) {
+            ByteBuffer d = p.header().duplicate();
+            byte[] h = new byte[d.remaining()];
+            d.get(h);
+            out.add(new Handed(p.n(), h, p.length()));
+        }
+        return out;
+    }
+
+    /**
+     * Pairs until every segment of {@code want} was handed out, as the Replicator does: one {@code pair} at once and one more
+     * after each pre-open this fake is told of (a pre-open that ended before {@code replicate} is found by the first call).
+     * Bounded by {@link JournalFixture#BOUND}.
+     */
+    List<Handed> pairUntil(Journal.Copies copies, Set<Long> want) {
+        List<Handed> handed = new ArrayList<>();
+        int seen = preopened.size();
+        handed.addAll(handOut(copies));
+        long deadline = System.nanoTime() + JournalFixture.BOUND.toNanos();
+        while (!numbers(handed).containsAll(want)) {
+            if (System.nanoTime() - deadline > 0) {
+                throw new AssertionError("pair never handed out " + want + " within " + JournalFixture.BOUND + ": handed " + numbers(handed)
+                        + ", pre-opens reported " + preopenedNumbers());
+            }
+            int now = preopened.size();
+            if (now > seen) {
+                seen = now;
+                handed.addAll(handOut(copies));
+            }
+            Thread.onSpinWait();
+        }
+        return handed;
+    }
+
+    static Set<Long> numbers(List<Handed> handed) {
+        Set<Long> s = new TreeSet<>();
+        for (Handed h : handed) s.add(h.n());
+        return s;
+    }
+
+    /** The bytes {@code [from, to)} of segment {@code n}'s file under {@code dir}. */
+    static byte[] fileBytes(Path dir, long n, long from, long to) throws java.io.IOException {
+        byte[] all = Files.readAllBytes(segmentFile(dir, n));
+        if (to > all.length) throw new AssertionError("segment " + n + " holds " + all.length + " bytes, not " + to);
+        return Arrays.copyOfRange(all, (int) from, (int) to);
+    }
+
+    static Path segmentFile(Path dir, long n) {
+        return dir.resolve("segments").resolve(n + ".seg").toAbsolutePath().normalize();
+    }
+}
