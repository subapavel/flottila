+/**
+ * The journal side of the two-copy ACK (CORE-5b2a1, acceptance T1–T11): with a {@link Replication} set, a record of a paired
+ * segment completes only once it is forced and its peer copy reaches its end, in journal position order, its bytes leaving
+ * {@code FLOTTILA_JOURNAL_PENDING_BYTES} at that completion; a segment's mode is fixed at its first reservation; the hooks run
+ * beside the force and outside the journal's lock; {@link Journal.Copies} turns segments single, fails their waiting records,
+ * seals early and fences. The Replication is the scripted fake {@link ScriptedReplication}; every interleaving is staged by the
+ * {@link HeldFiles} seam, the fake clock and timer, never by a sleep.
+ *
+ * <p>A negative ("does not complete") is witnessed by an outcome that cannot be vacuous: the record is then failed by
+ * {@code failed}, {@code fenced} or a failed force and must end <em>failed</em>; had it been acknowledged early it would have
+ * left the journal's waiting records and end succeeded. "Its round is done" is witnessed by the writer taking the next round
+ * (a follower record's write entered).
+ */
+class JournalCopiesTest {
+
+    /** Segment 1 is a fresh journal's first segment, 2 the one pre-opened at its open (CORE-3 item 3). */
+    private static final long FIRST = 1;
+    private static final long PREOPENED = 2;
+    /** The segment header of node {@code node-1}: magic 4, version 1, journal id 16, node (u16 + 6), n 8, created 8, crc 4. */
+    private static final int HEADER = 49;
+    /** A record's bytes besides its message id and body (part "in", one chunk): fixed 46, part 2, tag 16. */
+    private static final int OVERHEAD = 64;
+    private static final Duration WAIT = Duration.ofSeconds(2);
+    /** The bound of a hook's reaction run elsewhere: below {@link JournalFixture#BOUND}, so a stuck hook is named first. */
+    private static final Duration INNER = Duration.ofSeconds(5);
+
+    @TempDir Path tmp;
+
+    private final FakeClock clock = FakeClock.at(START);
+    private final LoggedTimer timer = new LoggedTimer(new FakeTimer(clock));
+    private final List<HeldFiles> seams = new ArrayList<>();
+    private final List<Journal> journals = new ArrayList<>();
+
+    @AfterEach
+    void closeEverything() throws Exception {
+        seams.forEach(HeldFiles::releaseAll);
+        for (Journal j : journals) onVirtual(() -> {
+            j.close();
+            return null;
+        }).join();
+    }
+
+    /** A journal, its seam and, once {@link #replicated}, its scripted Replication and Copies. */
+    private record World(Journal journal, HeldFiles files, Path dir, ScriptedReplication repl, Journal.Copies copies) { }
+
+    private Settings quiet(String name) throws IOException {
+        Path dir = Files.createDirectories(tmp.resolve(name));
+        return settings(dir).segmentAge(Duration.ofHours(1)).appendWait(WAIT);
+    }
+
+    private World plain(Settings s) throws Exception {
+        HeldFiles files = new HeldFiles();
+        seams.add(files);
+        Journal j = Journal.open(s.config(), clock, timer, keys(KEY), files);
+        journals.add(j);
+        return new World(j, files, s.dir, null, null);
+    }
+
+    private World replicated(Settings s) throws Exception {
+        World w = plain(s);
+        ScriptedReplication repl = new ScriptedReplication(w.files::now);
+        Journal.Copies copies = w.journal.replicate(repl);
+        assertNotNull(copies, "replicate answers the journal's Copies");
+        return new World(w.journal, w.files, w.dir, repl, copies);
+    }
