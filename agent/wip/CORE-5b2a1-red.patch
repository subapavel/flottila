+        assertEquals(0, w.copies.singleBytes());
+
+        w.copies.single(Set.of(FIRST));
+        await(r0.forced());
+        await(r1.forced());
+        await(f.forced());
+        assertEquals(1, w.copies.singleSegments(), "segment 1 turned single");
+        assertTrue(w.copies.singleBytes() >= r0.ref().length() + r1.ref().length(), "its records' bytes count as single: " + w.copies.singleBytes());
+    }
+
+    @Test
+    void singleSegmentsAreCountedAndTheirTransitionLoggedOnce() throws Exception {
+        World base = plain(quiet("single-count").segmentRecords(1));
+        try (LogCapture log = new LogCapture()) {
+            ScriptedReplication repl = new ScriptedReplication(base.files::now);
+            Journal.Copies copies = base.journal.replicate(repl);
+            assertEquals(0, copies.singleSegments(), "no segment is single before its first record");
+            Journal.Appended r0 = base.journal.append(record("sc-0", 100), live());   // never paired: single
+            Journal.Appended r1 = base.journal.append(record("sc-1", 200), live());   // the next segment, never paired either
+            assertNotEquals(r0.ref().segment(), r1.ref().segment());
+            await(r0.forced());
+            await(r1.forced());
+
+            assertEquals(2, copies.singleSegments(), "two frozen-single segments while a Replication is set");
+            assertTrue(copies.singleBytes() >= r0.ref().length() + r1.ref().length(), "their records' bytes count: " + copies.singleBytes());
+            assertEquals(1, singleLines(log).size(), "the transition to single is logged once, not per segment: " + log.lines());
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------------ T8
+
+    @Test
+    void failedFailsTheWaitingRecordsOfItsSegmentsAndFreesTheirBytes() throws Exception {
+        World w = replicated(quiet("failed").segmentRecords(2).recordMax(8192).pendingBytes(8192));
+        w.repl.pairUntil(w.copies, Set.of(FIRST, PREOPENED));
+        Journal.Appended r0 = w.journal.append(sized("fl-0", 2000), live());
+        Journal.Appended r1 = w.journal.append(sized("fl-1", 2000), live());
+        Journal.Appended r2 = w.journal.append(sized("fl-2", 2000), live());
+        assertEquals(FIRST, r1.ref().segment());
+        assertEquals(PREOPENED, r2.ref().segment());
+        Journal.Appended f = afterTheRoundOf(w, "fl-2", "fl-f");   // segment 2's second record: 6168 bytes pending
+
+        int waits = timer.withDelay(WAIT).size();
+        Outcome<Journal.Appended> next = onVirtual(() -> w.journal.append(sized("fl-w", 4000), live()));
+        untilTakenOrWaiting(next, waits, "fl-w");
+        assertFalse(next.done(), "4000 more do not fit under 8192 beside 6168 pending");
+
+        Map<String, Thread> completedOn = new ConcurrentHashMap<>();
+        r0.forced().onComplete(ar -> completedOn.put("fl-0", Thread.currentThread()));
+        r1.forced().onComplete(ar -> completedOn.put("fl-1", Thread.currentThread()));
+        JournalPeerLostException e = lost("segment 1");
+        Thread caller = onVirtual(() -> {
+            w.copies.failed(Set.of(FIRST), e);
+            return Thread.currentThread();
+        }).join();
+        assertSame(e, failureOf(r0.forced()), "a waiting record of segment 1 fails with the loss, retryable");
+        assertSame(e, failureOf(r1.forced()));
+        until(() -> completedOn.size() == 2, () -> "both listeners ran");
+        for (Thread t : completedOn.values()) {
+            assertTrue(t.isVirtual() && t != caller, "a failure completes on a fresh virtual thread, not failed()'s caller: " + t);
+        }
+
+        Journal.Appended taken = next.join();   // the failed records' 4000 bytes left the bound
+        assertNotNull(taken.ref());
+        assertFalse(r2.forced().isComplete(), "segment 2 is not in the loss: fl-2 still waits for its own copy");
+        w.copies.copied(PREOPENED, end(f));
+        await(r2.forced());
+        await(f.forced());
+    }
+
+    // ------------------------------------------------------------------------------------------------ T9
+
+    @Test
+    void sealEarlySealsTheActiveSegmentAndTheNextAppendGoesToANewOne() throws Exception {
+        World w = replicated(quiet("seal-early"));
+        w.repl.pairUntil(w.copies, Set.of(FIRST));
+        Journal.Appended r0 = w.journal.append(record("se-0", 100), live());
+        assertEquals(FIRST, r0.ref().segment());
+        assertEquals(Optional.empty(), w.journal.index(FIRST));
+
+        w.copies.sealEarly(FIRST);
+        Journal.Appended r1 = w.journal.append(record("se-1", 100), live());
+        assertTrue(r1.ref().segment() > FIRST, "the next append goes to a new segment: " + r1.ref());
+        until(() -> indexed(w.journal, FIRST), () -> "segment 1 is sealed");
+        List<JournalIndexEntry> entries = w.journal.index(FIRST).orElseThrow();
+        assertEquals(List.of(r0.ref()), entries.stream().map(JournalIndexEntry::ref).toList(), "segment 1 sealed with se-0 alone");
+    }
+
+    @Test
+    void sealEarlyOfASegmentWithoutRecordsDoesNothing() throws Exception {
+        World w = replicated(quiet("seal-early-empty"));
+        w.repl.pairUntil(w.copies, Set.of(FIRST));
+        w.copies.sealEarly(FIRST);
+        Journal.Appended r0 = w.journal.append(record("sn-0", 100), live());
+        assertEquals(FIRST, r0.ref().segment(), "an empty segment never rolls: the next append still goes to segment 1");
+        until(() -> w.files.forcedPast("sn-0"), () -> "sn-0 is forced");
+        assertEquals(Optional.empty(), w.journal.index(FIRST), "segment 1 was not sealed");
+    }
+
+    // ------------------------------------------------------------------------------------------------ T10
+
+    @Test
+    void fencedFailsTheJournal() throws Exception {
+        World w = replicated(quiet("fenced"));
+        w.repl.pairUntil(w.copies, Set.of(FIRST));
+        Journal.Appended r0 = w.journal.append(record("fn-0", 100), live());
+        afterTheRoundOf(w, "fn-0", "fn-f");
+        assertFalse(r0.forced().isComplete());
+
+        IllegalStateException fence = new IllegalStateException("fenced (test): the node's lease is gone");
+        w.copies.fenced(fence);
+        Throwable failed = failureOf(r0.forced());
+        assertInstanceOf(JournalFailedException.class, failed, "a record waiting for its copy fails with the journal");
+        assertSame(fence, failed.getCause(), "the journal failed because of the fence");
+        assertTrue(w.journal.isFailed());
+        assertInstanceOf(JournalFailedException.class, appendFailure(w.journal, record("fn-1", 100)), "a later append is refused");
+    }
+
+    // ------------------------------------------------------------------------------------------------ T11
+
+    @Test
+    void completionRunsOnAFreshVirtualThreadNotTheWriterNorASealer() throws Exception {
+        World w = replicated(quiet("threads-hooks").segmentRecords(1));
+        ScriptedReplication repl = w.repl;
+        // segment 1's copy arrives in wrote, on the writer, before its force; segment 2's in sealed, on its sealer, after it
+        repl.onWrote = x -> {
+            if (x.n() == FIRST) w.copies.copied(x.n(), x.end());
+        };
+        repl.onSealed = s -> {
+            if (s.n() == PREOPENED) w.copies.copied(s.n(), s.end());
+        };
+        repl.pairUntil(w.copies, Set.of(FIRST, PREOPENED));
+        Map<String, Thread> completedOn = new ConcurrentHashMap<>();
+        List<Journal.Appended> all = new ArrayList<>();
+        for (String id : List.of("tw-0", "tw-1", "tw-2")) {   // segments 1, 2 and 3 (never paired: single)
+            Journal.Appended a = w.journal.append(record(id, 100), live());
+            a.forced().onComplete(ar -> completedOn.put(id, Thread.currentThread()));
+            all.add(a);
+        }
+        for (Journal.Appended a : all) await(a.forced());
+        until(() -> completedOn.size() == 3, () -> "every listener ran");
+        assertEquals(List.of(), repl.errors);
+
+        Thread writer = w.files.firstWrite("tw-0").thread;
+        Set<Thread> hookCallers = ConcurrentHashMap.newKeySet();
+        hookCallers.add(writer);
+        for (Wrote x : repl.wrote) hookCallers.add(x.thread());
+        for (Sealed s : repl.sealed) hookCallers.add(s.thread());
+        for (ScriptedReplication.Preopened p : repl.preopened) hookCallers.add(p.thread());
+        assertFalse(repl.sealedOf(PREOPENED).isEmpty(), "segment 2's copy came from its sealer");
+        completedOn.forEach((id, t) -> {
+            assertTrue(t.isVirtual(), id + " completed on a virtual thread: " + t);
+            assertFalse(hookCallers.contains(t), id + " completed on " + t + ", a writer, sealer or hook caller thread: " + hookCallers);
+        });
+    }
+
+    @Test
+    void completionRunsOffTheThreadOfTheCopiesCall() throws Exception {
+        World w = replicated(quiet("threads-calls"));
+        w.repl.pairUntil(w.copies, Set.of(FIRST));
+        Journal.Appended r0 = w.journal.append(record("tc-0", 100), live());
+        Journal.Appended r1 = w.journal.append(record("tc-1", 100), live());
+        Journal.Appended f = afterTheRoundOf(w, "tc-1", "tc-f");
+        Map<String, Thread> completedOn = new ConcurrentHashMap<>();
+        r0.forced().onComplete(ar -> completedOn.put("tc-0", Thread.currentThread()));
+        r1.forced().onComplete(ar -> completedOn.put("tc-1", Thread.currentThread()));
+
+        Thread copier = onVirtual(() -> {
+            w.copies.copied(FIRST, end(r0));
+            return Thread.currentThread();
+        }).join();
+        await(r0.forced());
+        until(() -> w.files.forcedPast("tc-f"), () -> "tc-f is forced");
+        Thread singler = onVirtual(() -> {
+            w.copies.single(Set.of(FIRST));
+            return Thread.currentThread();
+        }).join();
+        await(r1.forced());
+        await(f.forced());
+        until(() -> completedOn.size() == 2, () -> "both listeners ran");
+        assertTrue(completedOn.get("tc-0").isVirtual() && completedOn.get("tc-0") != copier,
+                "tc-0 completed off copied()'s caller: " + completedOn.get("tc-0"));
+        assertTrue(completedOn.get("tc-1").isVirtual() && completedOn.get("tc-1") != singler,
+                "tc-1 completed off single()'s caller: " + completedOn.get("tc-1"));
+    }
+}
