+        List<Journal.Appended> fromHook = new CopyOnWriteArrayList<>();
+        List<Handed> handedInHook = new CopyOnWriteArrayList<>();
+        repl.onWrote = x -> {
+            if (appendedOnce.compareAndSet(false, true)) {
+                repl.elsewhere("an append in wrote(" + x.n() + ")", INNER, () -> fromHook.add(w.journal.append(record("hk-a", 100), live())));
+            }
+            repl.elsewhere("copied(" + x.n() + ", " + x.end() + ") in wrote", INNER, () -> {
+                w.copies.copied(x.n(), x.end());
+                return null;
+            });
+        };
+        repl.onSealed = s -> repl.elsewhere("copied(" + s.n() + ", " + s.end() + ") in sealed", INNER, () -> {
+            w.copies.copied(s.n(), s.end());
+            return null;
+        });
+        repl.onPreopened = p -> repl.elsewhere("pair in preopened(" + p.n() + ")", INNER, () -> handedInHook.addAll(handOut(w.copies)));
+        repl.pairUntil(w.copies, Set.of(FIRST));
