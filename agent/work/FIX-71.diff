+        @Override public void close() {}
+    };
+
+    @BeforeEach
+    void listen() {
+        capture.setLevel(Level.ALL);
+        flottila.addHandler(capture);
+    }
+
+    @AfterEach
+    void unlisten() {
+        flottila.removeHandler(capture);
+    }
