+        w.save("t");
+        assertEquals(6, w.windowsRefused());
+        assertEquals(3, warnings(), "and only its first refusal");
+        gateR.complete();
+        completeEveryOpenCommit();
+        assertEquals(List.of(), timer.escaped);
+    }
+}
