+        return assertInstanceOf(UnsettledException.class, failed, what + ": refused as unsettled: " + failed);
+    }
+
+    static List<Long> seqs(List<WorkQueue.Item> items) {
+        return items.stream().map(WorkQueue.Item::seq).toList();
+    }
