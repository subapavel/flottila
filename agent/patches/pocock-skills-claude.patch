@@ -0,0 +1,15 @@
+#!/bin/bash
+# Self-test for block-history-rewrite.sh: exit 0 when every case matches, 1 otherwise.
+h="$(dirname "$0")/block-history-rewrite.sh"; fail=0
+t(){ printf '{"tool_input":{"command":%s}}' "$(jq -Rn --arg c "$2" '$c')" | "$h" 2>/dev/null; r=$?
+     if [ "$r" != "$1" ]; then echo "FAIL got $r want $1: $2"; fail=1; fi; }
+for c in "git push --force origin main" "git push -f" "git push origin +main" \
+  "git -C /x push --force-with-lease" "git reset --hard HEAD~1" "git clean -fd" "git clean -xdf" \
+  "git branch -D foo" "git checkout ." "git checkout -- ." "git restore ." "git rebase main" \
+  "git commit --amend --no-edit" "cd a && git push -f origin x" "git stash drop" \
+  "git filter-branch --all"; do t 2 "$c"; done
+for c in "git push -u origin main" "git push origin main" "git status" "git checkout -- src/Foo.java" \
+  "git checkout main" "git restore src/A.java" "git commit -m 'reset --hard docs'" \
+  "git log --grep force" "git branch -d merged" "git reset HEAD file" "git clean -n" "ls -f" \
+  "rm -f target/.batch-in-review && git commit -F msg" "git diff --stat" "echo '{}'"; do t 0 "$c"; done
+[ $fail = 0 ] && echo "block-history-rewrite: all cases pass"; exit $fail
