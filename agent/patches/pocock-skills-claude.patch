diff --git a/.claude/hooks/block-history-rewrite.sh b/.claude/hooks/block-history-rewrite.sh
new file mode 100755
index 0000000..0ce117b
--- /dev/null
+++ b/.claude/hooks/block-history-rewrite.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+# PreToolUse(Bash) guard: blocks git commands that rewrite history or discard work.
+# CLAUDE.md: "Never ... force-push or rewrite history". A plain `git push` stays allowed.
+# Adapted from mattpocock/skills `git-guardrails-claude-code` (MIT, ../skills/LICENSE-mattpocock-skills).
+# Exit 2 = block; the stderr message is shown to the agent.
+
+cmd=$(jq -r '.tool_input.command // empty' 2>/dev/null)
+[ -z "$cmd" ] && exit 0
+
+# Normalise `git -C <dir>` / `git -c k=v` so the subcommand follows `git `.
+norm=$(printf '%s' "$cmd" | sed -E 's/git( +-(C|c) +[^ ]+)+/git/g')
+
+g='(^|[;&|(` ]|\$\()git +'
+rules=(
+  "${g}push( [^;&|]*)? (--force(-with-lease|-if-includes)?\b|-[a-zA-Z]*f\b|\+[^ ]+)|force-push"
+  "${g}reset( [^;&|]*)? --(hard|keep|merge)\b"
+  "${g}clean( [^;&|]*)? -[a-zA-Z]*f"
+  "${g}branch( [^;&|]*)? (-D\b|--delete --force|-d --force|-[a-zA-Z]*D)"
+  "${g}(checkout|restore)( [^;&|]*)? (--( |$))?\.( |$|;|&)"
+  "${g}(rebase|filter-branch|filter-repo|replace)\b"
+  "${g}commit( [^;&|]*)? --amend\b"
+  "${g}(update-ref +-d|reflog +(expire|delete)|gc +--prune=now)"
+  "${g}stash +(drop|clear)\b"
+)
+for r in "${rules[@]}"; do
+  if printf '%s' "$norm" | grep -qE -- "$r"; then
+    echo "BLOCKED by .claude/hooks/block-history-rewrite.sh: '$cmd' rewrites history or discards work (CLAUDE.md: never force-push or rewrite history). Restore a file with cp from a pristine copy; if this is really needed, write it in the handback or an issue for the owner." >&2
+    exit 2
+  fi
+done
+exit 0
diff --git a/.claude/hooks/block-history-rewrite.test.sh b/.claude/hooks/block-history-rewrite.test.sh
