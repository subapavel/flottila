+# non-zero on a > 20 % regression against bench/RESULTS.md. mutation: PIT on api + core. sim-fuzz (nightly, on demand):
+# fresh simulation seeds for 25 minutes under -Psim-fuzz, failures uploaded as pin lines (P2-10b).
 name: ci
 
 on:
@@ -188,3 +189,28 @@ jobs:
           name: pit-reports
           path: '**/target/pit-reports/**'
           if-no-files-found: ignore
+
+  sim-fuzz:
+    name: sim-fuzz (fresh simulation seeds, P2-10b)
+    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: ${{ env.JAVA_VERSION }}
+          cache: maven
+      - name: Build the simulation's modules
+        run: mvn -B -ntp -q install -DskipTests -pl flottila-sim -am
+      # SimFuzzTest runs only under -Psim-fuzz (excluded by default, never a skipped case); seeds from the run id, 25 minutes
+      - name: Fuzz the correct world
+        run: mvn -B -ntp -pl flottila-sim test -Psim-fuzz -Dsim.fuzz.base=${{ github.run_id }} -Dsim.fuzz.minutes=25 -Dsim.ticks=5000
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: sim-failures
+          path: flottila-sim/target/sim-failures.tsv
+          if-no-files-found: ignore
