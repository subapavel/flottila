@@ -0,0 +1,47 @@
+package io.flottila.sim;
+
+import io.flottila.api.BlobKey;
+import io.flottila.api.BlobNotFoundException;
+import io.flottila.api.BlobStore;
+import io.flottila.api.Body;
+import io.vertx.core.Future;
+import io.vertx.core.buffer.Buffer;
+import io.vertx.core.streams.ReadStream;
+
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Broken variant LOST_REPLAY_BODY (P2-10b): the blob store acknowledges the persist of every key of step 1 or later and drops
+ * the object — from then on the key reads as never stored. Built over the public {@link BlobStore} only.
+ */
+final class LostReplayBody implements World {
+
+    static final String NAME = "lost-replay-body";
+
+    @Override public String name() { return NAME; }
+
+    @Override public BlobStore blobs(BlobStore sim) {
+        Set<BlobKey> dropped = ConcurrentHashMap.newKeySet();
+        return new BlobStore() {
+            @Override public long treeLimit() { return sim.treeLimit(); }
+            @Override public Future<Body> write(BlobKey key, Buffer whole, long maxSize) { return sim.write(key, whole, maxSize); }
+            @Override public Future<Body> write(BlobKey key, ReadStream<Buffer> in, long maxSize) { return sim.write(key, in, maxSize); }
+            @Override public ReadStream<Buffer> open(BlobKey key) {
+                if (dropped.contains(key)) throw new BlobNotFoundException(key);
+                return sim.open(key);
+            }
+            @Override public Future<Buffer> read(BlobKey key) {
+                return dropped.contains(key) ? Future.failedFuture(new BlobNotFoundException(key)) : sim.read(key);
+            }
+            @Override public Future<Boolean> exists(BlobKey key) {
+                return dropped.contains(key) ? Future.succeededFuture(false) : sim.exists(key);
+            }
+            @Override public Future<Void> persist(BlobKey key) {
+                if (key.step() < 1) return sim.persist(key);
+                dropped.add(key);   // THE DEFECT: acknowledged, never made durable, gone
+                return Future.succeededFuture();
+            }
+        };
+    }
+}
