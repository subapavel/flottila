@@ -0,0 +1,43 @@
+package io.flottila.sim;
+
+import io.flottila.sim.SimFuzz.Fuzzed;
+import io.flottila.sim.SimFuzz.Settings;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+/**
+ * The nightly sim-fuzz run (P2-10b): only under {@code -Psim-fuzz} (the default run excludes it, SimFuzzProfileTest). Fresh
+ * seeds from {@code -Dsim.fuzz.base} for {@code -Dsim.fuzz.minutes} of wall time, the correct world, every run under the per-seed
+ * hang guard; each failure goes to {@code target/sim-failures.tsv} as a pin line, then the case fails naming them all.
+ */
+class SimFuzzTest {
+
+    @Test
+    void fuzzedSeedsPassAndEveryFailureIsPinned() throws IOException {
+        Settings settings = Settings.from(simProperties());
+        long end = System.nanoTime() + settings.budget().toNanos();   // the budget, not a timing assertion
+        Fuzzed fuzzed = SimFuzz.run(settings, () -> System.nanoTime() < end,
+                seed -> SimRuns.run(seed, settings.config(), settings.ticks(), World.CORRECT));
+        Path failures = Path.of("target", "sim-failures.tsv");
+        Files.createDirectories(failures.getParent());
+        Files.write(failures, fuzzed.failed().stream().map(v -> SimFuzz.pinLine(v, settings.base())).toList());
+        assertFalse(fuzzed.ran().isEmpty(), "the budget " + settings.budget() + " ran no seed");
+        assertEquals(List.of(), fuzzed.failed().stream().map(Verdict::report).toList(),
+                () -> fuzzed.failed().size() + " of " + fuzzed.ran().size() + " fuzzed seeds failed; pinned in " + failures.toAbsolutePath());
+    }
+
+    private static Map<String, String> simProperties() {
+        Map<String, String> out = new TreeMap<>();
+        for (String name : System.getProperties().stringPropertyNames()) if (name.startsWith("sim.")) out.put(name, System.getProperty(name));
+        return out;
