+                };
+            }
+            @Override public void onCompared(Compared c) { if (c.check() == Check.REPLAY_YIELDS_RECORDED || (c.check() == Check.SNAPSHOT_PER_STEP && c.part().isEmpty())) log.add("cmp " + c); }
