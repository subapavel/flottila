+package io.flottila.sim;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.EnumSet;
+
+import static io.flottila.sim.SimRuns.firstFailing;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * P2-10b: a lost replay body is caught by REPLAY_FROM on its own. LostReplayBody's per-push seed also trips REPLAY_YIELDS_RECORDED
+ * through RETRY_DLQ, so with RETRY_DLQ never drawn only the replay's own comparison, its output against the recorded hash, can fail.
+ */
+class ReplayFromLossTest {
+
+    @Test
+    void aLostBodyFailsTheReplayItselfWithoutDlqRetries() {
+        Verdict v = firstFailing(new LostReplayBody(), SimRuns.PER_PUSH_CONFIG.withWeight(Action.RETRY_DLQ, 0));
+        assertEquals(EnumSet.of(Check.REPLAY_YIELDS_RECORDED), v.failedChecks(), v::report);
+        assertTrue(v.failures().stream().allMatch(f -> f.detail().contains(", the replay of ")),
+                () -> "a failure that is not a REPLAY_FROM comparison:\n" + v.report());
+    }
+}
