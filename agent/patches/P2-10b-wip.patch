index 0000000..3a1725d
--- /dev/null
+++ b/flottila-sim/src/main/java/io/flottila/sim/DedupingIntake.java
@@ -0,0 +1,42 @@
+package io.flottila.sim;
+
+import io.flottila.api.Envelope;
+import io.flottila.core.flow.Intake;
+import io.flottila.core.record.Snapshot;
+import io.vertx.core.Future;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.BooleanSupplier;
+
+/**
+ * The at-least-once flow's dedupe as the simulation builds it (P2-10b, D-084): the sequential intake refuses a dedupe key, so
+ * this double keeps one: a save under a key already saved answers the id saved first and saves nothing; any other save goes to
+ * {@code intake} without the key, and its id becomes the key's first once it is saved. A save that fails leaves the key free.
+ * The durable processed-ids table of the Postgres intake comes in P2-10d; this one lives as long as the run.
+ */
+final class DedupingIntake implements Intake {
+
+    private final Intake intake;
+    private final Map<String, String> first = new HashMap<>();   // guarded by this: per flow and dedupe key, the id saved first
+
+    DedupingIntake(Intake intake) {
+        this.intake = intake;
+    }
+
+    @Override
+    public Future<String> save(Envelope arrived, Snapshot ingress, String flow, String partitionKey, String dedupeKey, BooleanSupplier abandoned) {
+        if (dedupeKey == null) return intake.save(arrived, ingress, flow, partitionKey, null, abandoned);
+        String scoped = flow + "/" + dedupeKey;
+        String saved;
+        synchronized (this) {
+            saved = first.get(scoped);
+        }
+        if (saved != null) return Future.succeededFuture(saved);
+        return intake.save(arrived, ingress, flow, partitionKey, null, abandoned).onSuccess(id -> {
+            synchronized (this) {
+                first.putIfAbsent(scoped, id);
+            }
+        });
+    }
+}
