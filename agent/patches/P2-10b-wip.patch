+++ b/flottila-sim/src/test/java/io/flottila/sim/SimFuzzProfileTest.java
@@ -0,0 +1,52 @@
+package io.flottila.sim;
+
+import org.junit.jupiter.api.Test;
+import org.w3c.dom.Document;
+import org.w3c.dom.NodeList;
+
+import javax.xml.parsers.DocumentBuilderFactory;
+import javax.xml.xpath.XPath;
+import javax.xml.xpath.XPathConstants;
+import javax.xml.xpath.XPathFactory;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * P2-10b: SimFuzzTest runs only under the {@code sim-fuzz} profile — excluded from the default surefire run (never a skipped
+ * case) and included by the profile. Reads flottila-sim's pom (the tests run from the module directory).
+ */
+class SimFuzzProfileTest {
+
+    private static final String FUZZ = "SimFuzzTest";
+
+    @Test
+    void simFuzzTestRunsOnlyUnderItsProfile() throws Exception {
+        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+        factory.setNamespaceAware(false);
+        Document pom = factory.newDocumentBuilder().parse(Path.of("pom.xml").toFile());
+        XPath x = XPathFactory.newInstance().newXPath();
+        String surefire = "plugin[artifactId='maven-surefire-plugin']/configuration";
+
+        List<String> defaultExcludes = texts(x, pom, "/project/build/plugins/" + surefire + "/excludes/exclude");
+        List<String> defaultIncludes = texts(x, pom, "/project/build/plugins/" + surefire + "/includes/include");
+        assertTrue(defaultExcludes.stream().anyMatch(e -> e.contains(FUZZ)), () -> "the default surefire run does not exclude " + FUZZ + ": " + defaultExcludes);
+        assertFalse(defaultIncludes.stream().anyMatch(e -> e.contains(FUZZ)), () -> "the default surefire run includes " + FUZZ + ": " + defaultIncludes);
+
+        String profile = "/project/profiles/profile[id='sim-fuzz']/build/plugins/" + surefire;
+        List<String> profileIncludes = texts(x, pom, profile + "/includes/include");
+        List<String> profileExcludes = texts(x, pom, profile + "/excludes/exclude");
+        assertTrue(profileIncludes.stream().anyMatch(e -> e.contains(FUZZ)), () -> "profile sim-fuzz does not include " + FUZZ + ": " + profileIncludes);
+        assertFalse(profileExcludes.stream().anyMatch(e -> e.contains(FUZZ)), () -> "profile sim-fuzz excludes " + FUZZ + ": " + profileExcludes);
+    }
+
+    private static List<String> texts(XPath x, Document doc, String path) throws Exception {
+        NodeList nodes = (NodeList) x.evaluate(path, doc, XPathConstants.NODESET);
+        List<String> out = new ArrayList<>();
+        for (int i = 0; i < nodes.getLength(); i++) out.add(nodes.item(i).getTextContent().trim());
+        return out;
+    }
+}
diff --git a/flottila-sim/src/test/java/io/flottila/sim/SimFuzzSettingsTest.java b/flottila-sim/src/test/java/io/flottila/sim/SimFuzzSettingsTest.java
new file mode 100644
index 0000000..54bfa22
--- /dev/null
+++ b/flottila-sim/src/test/java/io/flottila/sim/SimFuzzSettingsTest.java
@@ -0,0 +1,96 @@
+package io.flottila.sim;
+
+import io.flottila.sim.SimFuzz.Fuzzed;
+import io.flottila.sim.SimFuzz.Settings;
+import io.flottila.sim.Verdict.Failure;
+import org.junit.jupiter.api.Test;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** P2-10b sim-fuzz: what its properties say, which seeds it runs while its budget lasts, and the pin line of a failure. */
+class SimFuzzSettingsTest {
+
+    @Test
+    void theBudgetTakesAFractionOfAMinute() {
+        assertEquals(Duration.ofSeconds(3), Settings.from(Map.of("sim.fuzz.minutes", "0.05")).budget());
+        assertEquals(Duration.ofSeconds(90), Settings.from(Map.of("sim.fuzz.minutes", "1.5")).budget());
+        assertEquals(Duration.ofMinutes(25), Settings.from(Map.of("sim.fuzz.minutes", "25")).budget());
+    }
+
+    @Test
+    void thePropertiesNameBaseTicksAndConfigAndDefaultOtherwise() {
+        assertEquals(new Settings(0, Duration.ofMinutes(25), 1_000, SimConfig.V2), Settings.from(Map.of()));
+        assertEquals(new Settings(9_876_543_210L, Duration.ofMinutes(25), 5_000, SimConfig.V1),
+                Settings.from(Map.of("sim.fuzz.base", "9876543210", "sim.ticks", "5000", "sim.config", "V1")));
+    }
+
+    @Test
+    void aBudgetThatIsNoPositiveNumberIsRefused() {
+        for (String minutes : List.of("0", "-1", "abc", "NaN", "")) {
+            assertThrows(IllegalArgumentException.class, () -> Settings.from(Map.of("sim.fuzz.minutes", minutes)), "sim.fuzz.minutes=" + minutes);
+        }
+    }
+
+    @Test
+    void aFuzzRunTakesFreshSeedsWhileTimeIsLeft() {
+        Settings settings = Settings.from(Map.of("sim.fuzz.base", "77"));
+        List<SimSeed> runner = new ArrayList<>();
+        AtomicInteger left = new AtomicInteger(5);
+        Fuzzed fuzzed = SimFuzz.run(settings, () -> left.getAndDecrement() > 0, seed -> {
+            runner.add(seed);
+            return verdict(seed, runner.size() == 2 ? List.of(new Failure(Check.KEY_ORDER, 3, "x")) : List.of());
+        });
+        assertEquals(5, fuzzed.ran().size(), "one seed per 'time left'");
+        assertEquals(runner, fuzzed.ran(), "the seeds handed to the runner, in order");
+        for (int i = 0; i < 5; i++) assertEquals(SimFuzz.seed(77, i), fuzzed.ran().get(i), "seed " + i + " of base 77");
+        assertEquals(5, new HashSet<>(fuzzed.ran()).size(), "a seed run twice: " + fuzzed.ran());
+        assertEquals(List.of(fuzzed.ran().get(1)), fuzzed.failed().stream().map(Verdict::seed).toList(), "the failing run, and it alone");
+
+        AtomicInteger none = new AtomicInteger();
+        Fuzzed spent = SimFuzz.run(settings, () -> false, seed -> { none.incrementAndGet(); return verdict(seed, List.of()); });
+        assertEquals(List.of(), spent.ran(), "a spent budget runs nothing");
+        assertEquals(0, none.get());
+    }
+
+    @Test
+    void seedsComeFromTheBaseAndMissThePerPushSet() {
+        Set<SimSeed> fromZero = new HashSet<>();
+        Set<SimSeed> fromOne = new HashSet<>();
+        for (long i = 0; i < 64; i++) {
+            fromZero.add(SimFuzz.seed(0, i));
+            fromOne.add(SimFuzz.seed(1, i));
+            assertEquals(SimFuzz.seed(0, i), SimFuzz.seed(0, i), "seed " + i + " of base 0 drawn twice");
+        }
+        assertEquals(64, fromZero.size());
+        Set<SimSeed> shared = new HashSet<>(fromZero);
+        shared.retainAll(fromOne);
+        assertEquals(Set.of(), shared, "bases 0 and 1 share seeds: base + i is no mix");
+        Set<SimSeed> perPush = new HashSet<>(fromZero);
+        perPush.retainAll(SimRuns.PER_PUSH);
+        assertEquals(Set.of(), perPush, "the fuzz re-runs per-push seeds");
+    }
+
+    @Test
+    void aFailureLineIsAPin() {
+        Verdict failed = new Verdict(new SimSeed(0x2aL), SimConfig.V2, 5_000, "correct",
+                List.of(new Failure(Check.KEY_ORDER, 3, "x"), new Failure(Check.PREDICTED, 9, "y")), Map.of(Check.KEY_ORDER, 4L), "d");
+        assertEquals("0x2a\tV2\t5000\tcorrect\tFAIL:PREDICTED,KEY_ORDER\t# sim-fuzz base=7", SimFuzz.pinLine(failed, 7));
+        assertFalse(SimFuzz.pinLine(failed, 7).contains("\n"), "one line");
+        assertTrue(SimFuzz.pinLine(failed, 123456789012L).endsWith("# sim-fuzz base=123456789012"));
+    }
+
+    private static Verdict verdict(SimSeed seed, List<Failure> failures) {
+        return new Verdict(seed, SimConfig.V2, 1_000, "correct", failures, Map.of(Check.PREDICTED, 1L), "d");
+    }
+}
