+        return calls.stream().filter(c -> c.messageId().equals(messageId)).toList();
+    }
+
+    List<Unit> unitsOf(String messageId) {
+        return units.stream().filter(u -> u.messageId().equals(Optional.of(messageId))).toList();
+    }
+}
diff --git a/flottila-sim/src/test/java/io/flottila/sim/SimActionsTest.java b/flottila-sim/src/test/java/io/flottila/sim/SimActionsTest.java
new file mode 100644
index 0000000..7dd5903
--- /dev/null
+++ b/flottila-sim/src/test/java/io/flottila/sim/SimActionsTest.java
@@ -0,0 +1,136 @@
+package io.flottila.sim;
+
+import io.flottila.sim.World.Compared;
+import io.flottila.sim.World.PartnerCall;
+import io.flottila.sim.World.Unit;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import static io.flottila.sim.SimRuns.PER_PUSH;
+import static io.flottila.sim.SimRuns.PER_PUSH_CONFIG;
+import static io.flottila.sim.SimRuns.TICKS;
+import static io.flottila.sim.SimRuns.run;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * P2-10b actions under the per-push config: each one's prediction is compared (counted under its action's name), holds, and
+ * leaves the trace its prediction says — seen through the partner calls and the driver's units, not through the oracle alone.
+ */
+class SimActionsTest {
+
+    /** The first per-push seeds a case runs. */
+    private static final List<SimSeed> SEEDS = PER_PUSH.subList(0, 4);
+
+    /** Every comparison under {@code action}'s name over {@link #SEEDS}, each run passing; the {@link Seen} of each run beside. */
+    private record Runs(List<Seen> seen, List<Compared> compared) {}
+
+    private static Runs runs(Action action) {
+        List<Seen> all = new ArrayList<>();
+        List<Compared> compared = new ArrayList<>();
+        for (SimSeed seed : SEEDS) {
+            Seen seen = new Seen();
+            Verdict v = run(seed, PER_PUSH_CONFIG, TICKS, seen);
+            assertTrue(v.passed(), v::report);
+            all.add(seen);
+            compared.addAll(seen.comparedAs(action.name()));
+        }
+        assertFalse(compared.isEmpty(), () -> action + " was never compared over " + SEEDS + " under " + PER_PUSH_CONFIG.name());
+        List<Compared> failed = compared.stream().filter(c -> !c.held()).toList();
+        assertEquals(List.of(), failed, () -> action + "'s prediction did not hold");
+        return new Runs(all, compared);
+    }
+
+    /** The message ids the comparisons are about, per run. */
+    private static Set<String> ids(Seen seen, Action action) {
+        return seen.comparedAs(action.name()).stream().map(Compared::messageId).flatMap(Optional::stream).collect(Collectors.toSet());
+    }
+
+    @Test
+    void anAtMostOnceSendRunsOnce() {
+        Runs r = runs(Action.SEND_AMO);
+        int called = 0;
+        for (Seen seen : r.seen()) {
+            for (String id : ids(seen, Action.SEND_AMO)) {
+                List<PartnerCall> calls = seen.callsOf(id);
+                if (!calls.isEmpty()) called++;
+                assertTrue(calls.stream().allMatch(c -> c.attempt() == 1), () -> id + " ran again after its ACK: " + calls);
+                List<Unit> polls = seen.unitsOf(id).stream().filter(u -> u.kind() == Unit.Kind.POLL).toList();
+                assertEquals(List.of(), polls, () -> id + " was queued: an at-most-once send saves nothing to run again");
+            }
+        }
+        assertTrue(called > 0, "no at-most-once send reached the partner: 'runs once' was never seen");
+    }
+
+    @Test
+    void aDuplicateNamesTheFirstId() {
+        Runs r = runs(Action.DUPLICATE);
+        for (Seen seen : r.seen()) {
+            for (String id : ids(seen, Action.DUPLICATE)) {
+                assertTrue(seen.unitsOf(id).stream().anyMatch(u -> u.kind() == Unit.Kind.START), () -> "the duplicate " + id + " was never sent");
+                assertEquals(List.of(), seen.callsOf(id), () -> "the duplicate " + id + " had an effect of its own");
+            }
+            assertTrue(seen.comparedUnder(Check.ONE_ID_PER_DEDUPE_KEY) > 0, "duplicates sent, ONE_ID_PER_DEDUPE_KEY never compared");
+        }
+    }
+
+    @Test
+    void aReplayYieldsTheRecordedOutput() {
+        Runs r = runs(Action.REPLAY_FROM);
+        assertTrue(r.compared().stream().allMatch(c -> c.check() == Check.REPLAY_YIELDS_RECORDED),
+                () -> "a REPLAY_FROM prediction counted under another check: " + r.compared());
+        boolean replayCalled = false;
+        for (Seen seen : r.seen()) {
+            Set<String> sent = seen.units.stream().filter(u -> u.kind() == Unit.Kind.START).map(Unit::messageId).flatMap(Optional::stream)
+                    .collect(Collectors.toSet());
+            replayCalled |= seen.calls.stream().anyMatch(c -> !sent.contains(c.messageId()));   // a replay's id is no send's
+        }
+        assertTrue(replayCalled, "no replay reached the partner under an id of its own: the replays ran nothing");
+    }
+
+    @Test
+    void aRetriedDlqRowIsFinal() {
+        Runs r = runs(Action.RETRY_DLQ);
+        int parkedAfter = PER_PUSH_CONFIG.retries() + 1;
+        for (Seen seen : r.seen()) {
+            for (String id : ids(seen, Action.RETRY_DLQ)) {
+                List<PartnerCall> calls = seen.callsOf(id);
+                long refused = calls.stream().filter(c -> !c.delivered()).count();
+                assertTrue(refused >= parkedAfter, () -> id + " was retried from the DLQ but never parked there: " + calls);
+            }
+        }
+    }
+
+    @Test
+    void anOutageParksAfterRetries() {
+        Runs r = runs(Action.PARTNER_OUTAGE);
+        int perMessage = PER_PUSH_CONFIG.retries() + 1;
+        for (Seen seen : r.seen()) {
+            for (String id : ids(seen, Action.PARTNER_OUTAGE)) {
+                List<PartnerCall> calls = seen.callsOf(id);
+                assertEquals(perMessage, calls.size(), () -> id + " in the outage: one call and " + PER_PUSH_CONFIG.retries() + " retries, was " + calls);
+                assertTrue(calls.stream().noneMatch(PartnerCall::delivered), () -> id + " got through the outage: " + calls);
+                List<Unit> units = seen.unitsOf(id);
+                assertTrue(units.stream().anyMatch(u -> u.kind() == Unit.Kind.WAKE), () -> id + " never backed off: " + units);
+            }
+        }
+    }
+
+    @Test
+    void aDroppedReplyRerunsTheSameId() {
+        Runs r = runs(Action.DROP_REPLY);
+        for (Seen seen : r.seen()) {
+            for (String id : ids(seen, Action.DROP_REPLY)) {
+                List<PartnerCall> calls = seen.callsOf(id);
+                assertTrue(calls.size() >= 2, () -> id + "'s reply was dropped but the same id never ran again: " + calls);
+                assertTrue(calls.getFirst().delivered(), () -> id + "'s first call had no effect: the drop lost nothing done");
+            }
+        }
+    }
+}
diff --git a/flottila-sim/src/test/java/io/flottila/sim/SimComparedTest.java b/flottila-sim/src/test/java/io/flottila/sim/SimComparedTest.java
new file mode 100644
index 0000000..27857b8
--- /dev/null
+++ b/flottila-sim/src/test/java/io/flottila/sim/SimComparedTest.java
@@ -0,0 +1,103 @@
+package io.flottila.sim;
+
+import io.flottila.sim.World.Compared;
+import io.flottila.api.Ack;
+import io.flottila.api.BlobStore;
+import io.flottila.api.Envelope;
+import io.flottila.api.Step;
+import io.flottila.core.flow.Delivery;
+import io.flottila.core.flow.Intake;
+import io.flottila.core.queue.WorkQueue;
+import io.vertx.core.Future;
+import org.junit.jupiter.api.Test;
+
+import java.time.Clock;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.function.Function;
+import java.util.function.Supplier;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.stream.Collectors;
+
+import static io.flottila.sim.SimRuns.PER_PUSH_CONFIG;
+import static io.flottila.sim.SimRuns.TICKS;
+import static io.flottila.sim.SimRuns.run;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+/** P2-10b: every comparison is told to the world, and ADMISSION_BOUNDS counts its three parts apart. */
+class SimComparedTest {
+
+    private static final Set<String> PARTS = Set.of(Compared.REQUESTS, Compared.BYTES, Compared.WORKER_RUNS);
+
+    @Test
+    void everyComparisonIsToldToTheWorld() {
+        Seen seen = new Seen();
+        Verdict v = run(new SimSeed(1), PER_PUSH_CONFIG, TICKS, seen);
+        assertTrue(v.passed(), v::report);
+        Map<Check, Long> told = new TreeMap<>(seen.compared.stream().collect(Collectors.groupingBy(Compared::check, Collectors.counting())));
+        Map<Check, Long> counted = new TreeMap<>(v.compared());
+        counted.values().removeIf(n -> n == 0);
+        assertEquals(counted, told, "the verdict's compared counts and the comparisons the world was told");
+        assertTrue(seen.compared.stream().allMatch(Compared::held), "a passing run told a comparison that did not hold");
+    }
+
+    @Test
+    void admissionBoundsCountsEachPartApart() {
+        Seen seen = new Seen();
+        Verdict v = run(new SimSeed(1), PER_PUSH_CONFIG, TICKS, seen);
+        assertTrue(v.passed(), v::report);
+        List<Compared> bounds = seen.compared.stream().filter(c -> c.check() == Check.ADMISSION_BOUNDS).toList();
+        Map<String, Long> byPart = bounds.stream().collect(Collectors.groupingBy(Compared::part, Collectors.counting()));
+        assertEquals(PARTS, byPart.keySet(), "ADMISSION_BOUNDS parts compared: " + byPart);
+        assertEquals(v.compared().get(Check.ADMISSION_BOUNDS), byPart.values().stream().mapToLong(Long::longValue).sum(),
+                "the parts add up to ADMISSION_BOUNDS's count");
+    }
+
+    @Test
+    void aBrokenBoundFailsInItsOwnPart() {
+        assertEquals(Set.of(Compared.WORKER_RUNS), failedParts(new OverClaim()), "a worker running past its limit");
+        Set<String> doubled = failedParts(new DoubleAdmission());
+        assertTrue(Set.of(Compared.REQUESTS, Compared.BYTES).containsAll(doubled) && !doubled.isEmpty(),
+                () -> "a flow admitting twice its limits fails in requests or bytes, was " + doubled);
+    }
+
+    /** The ADMISSION_BOUNDS parts whose comparisons did not hold in {@code world}'s first failing per-push run. */
+    private static Set<String> failedParts(World world) {
+        for (SimSeed seed : SimRuns.PER_PUSH) {
+            Told told = new Told(world);
+            Verdict v = run(seed, PER_PUSH_CONFIG, TICKS, told);
+            if (v.passed()) continue;
+            assertEquals(Set.of(Check.ADMISSION_BOUNDS), v.failedChecks(), v::report);
+            return told.compared.stream().filter(c -> c.check() == Check.ADMISSION_BOUNDS && !c.held()).map(Compared::part)
+                    .collect(Collectors.toSet());
+        }
+        return fail("world " + world.name() + " passed every per-push seed");
+    }
+
+    /** {@code inner} with every seam as it is, the comparisons recorded. */
+    private static final class Told implements World {
+        final ConcurrentLinkedQueue<Compared> compared = new ConcurrentLinkedQueue<>();
+        private final World inner;
+
+        Told(World inner) { this.inner = inner; }
+
+        @Override public String name() { return inner.name(); }
+        @Override public Intake intake(Intake sim) { return inner.intake(sim); }
+        @Override public WorkQueue queue(WorkQueue sim, Clock clock) { return inner.queue(sim, clock); }
+        @Override public Function<Envelope, Future<Ack>> entry(String flow, Supplier<Delivery> deliveries) { return inner.entry(flow, deliveries); }
+        @Override public Step transform(Step sim) { return inner.transform(sim); }
+        @Override public BlobStore blobs(BlobStore sim) { return inner.blobs(sim); }
+        @Override public void onUnit(Unit unit) { inner.onUnit(unit); }
+        @Override public void onDraw(Draw draw) { inner.onDraw(draw); }
+        @Override public void onCall(PartnerCall call) { inner.onCall(call); }
+        @Override public void onCompared(Compared c) {
+            compared.add(c);
+            inner.onCompared(c);
+        }
+    }
+}
diff --git a/flottila-sim/src/test/java/io/flottila/sim/SimFuzzProfileTest.java b/flottila-sim/src/test/java/io/flottila/sim/SimFuzzProfileTest.java
