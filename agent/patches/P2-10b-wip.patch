+import java.util.concurrent.ConcurrentLinkedQueue;
+
+/** The correct world, recording what the driver, the partner and the oracle tell it (P2-10b observers). */
+final class Seen implements World {
+
+    final ConcurrentLinkedQueue<Unit> units = new ConcurrentLinkedQueue<>();
+    final ConcurrentLinkedQueue<PartnerCall> calls = new ConcurrentLinkedQueue<>();
+    final ConcurrentLinkedQueue<Compared> compared = new ConcurrentLinkedQueue<>();
+
+    @Override public String name() { return "correct"; }
+
+    @Override public void onUnit(Unit unit) { units.add(unit); }
+
+    @Override public void onCall(PartnerCall call) { calls.add(call); }
+
+    @Override public void onCompared(Compared c) { compared.add(c); }
+
+    List<Compared> comparedAs(String part) {
+        return compared.stream().filter(c -> c.part().equals(part)).toList();
+    }
+
+    long comparedUnder(Check check) {
+        return compared.stream().filter(c -> c.check() == check).count();
+    }
+
