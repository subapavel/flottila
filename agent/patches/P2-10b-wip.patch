+package io.flottila.sim;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.function.BooleanSupplier;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+
+/**
+ * The nightly {@code sim-fuzz} job's run (P2-10b, D-101): fresh seeds from a base (the CI run id) for a wall-clock budget, every
+ * failing run written as a line of the pinned-seeds format.
+ */
+public final class SimFuzz {
+
+    /** What a fuzz base is mixed with before its seeds are drawn: no base's seeds are another's or the per-push ones. */
+    private static final long SALT = 0xa54ff53a5f1d36f1L;
+
+    private SimFuzz() {}
+
+    /**
+     * What a fuzz run is told by its system properties.
+     *
+     * @param base {@code sim.fuzz.base}: where its seeds come from
+     * @param budget {@code sim.fuzz.minutes}, a fraction accepted (0.05 = 3 s)
+     * @param ticks {@code sim.ticks}
+     * @param config {@code sim.config}
+     */
+    public record Settings(long base, Duration budget, int ticks, SimConfig config) {
+
+        /** The settings the properties name; defaults base 0, 25 minutes, 1 000 ticks, V2. */
+        public static Settings from(Map<String, String> properties) {
+            double minutes = Double.parseDouble(properties.getOrDefault("sim.fuzz.minutes", "25"));   // "abc", "": an IAE of its own
+            if (!(minutes > 0)) throw new IllegalArgumentException("sim.fuzz.minutes must be a positive number of minutes, was " + minutes);
+            return new Settings(Long.parseLong(properties.getOrDefault("sim.fuzz.base", "0")), Duration.ofMillis(Math.round(minutes * 60_000)),
+                    Integer.parseInt(properties.getOrDefault("sim.ticks", "1000")), SimConfig.named(properties.getOrDefault("sim.config", "V2")));
+        }
+    }
+
+    /**
+     * What a fuzz run did.
+     *
+     * @param ran the seeds it ran, in order
+     * @param failed the verdicts that did not pass, in order
+     */
+    public record Fuzzed(List<SimSeed> ran, List<Verdict> failed) {}
+
+    /** The {@code i}-th seed of a fuzz run from {@code base}. */
+    public static SimSeed seed(long base, long i) {
+        return new SimSeed(Mix.mix(Mix.splitMix64(base ^ SALT), i));
+    }
+
+    /** Runs seed 0, 1, … of {@code settings.base()} through {@code runner} while {@code timeLeft} says so. */
+    public static Fuzzed run(Settings settings, BooleanSupplier timeLeft, Function<SimSeed, Verdict> runner) {
+        List<SimSeed> ran = new ArrayList<>();
+        List<Verdict> failed = new ArrayList<>();
+        for (long i = 0; timeLeft.getAsBoolean(); i++) {
+            SimSeed seed = seed(settings.base(), i);
+            ran.add(seed);
+            Verdict v = runner.apply(seed);
+            if (!v.passed()) failed.add(v);
+        }
+        return new Fuzzed(ran, failed);
+    }
+
+    /** {@code failed} as a pinned-seeds line: {@code seed⇥config⇥ticks⇥world⇥FAIL:Check,…⇥# sim-fuzz base=<base>}. */
+    public static String pinLine(Verdict failed, long base) {
+        return failed.seed().hex() + "\t" + failed.config().name() + "\t" + failed.ticks() + "\t" + failed.world() + "\tFAIL:"
+                + failed.failedChecks().stream().map(Check::name).collect(Collectors.joining(",")) + "\t# sim-fuzz base=" + base;
+    }
+}
