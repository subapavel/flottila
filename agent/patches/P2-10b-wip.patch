+package io.flottila.sim;
+
+import io.flottila.core.flow.Intake;
+
+/**
+ * Broken variant IDEMPOTENT_CHECK_REMOVED (P2-10b): the intake decorator passes every save on without its dedupe key, so a
+ * duplicate is saved as a message of its own. Built over the public {@link Intake} only.
+ */
+final class IdempotentCheckRemoved implements World {
+
+    static final String NAME = "idempotent-check-removed";
+
+    @Override public String name() { return NAME; }
+
+    @Override public Intake intake(Intake sim) {
+        return (arrived, ingress, flow, partitionKey, dedupeKey, abandoned) -> sim.save(arrived, ingress, flow, partitionKey, null, abandoned);
+    }
+}
