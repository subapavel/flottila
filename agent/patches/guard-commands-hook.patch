index 0000000..86e4c5d
--- /dev/null
+++ b/.claude/hooks/guard-commands.py
@@ -0,0 +1,267 @@
+#!/usr/bin/env python3
+"""PreToolUse(Bash) guard: blocks git commands that rewrite history, destroy remote refs or
+discard work, and `mvn clean` without `-pl`/`-f` (it deletes the reactor root's target/, which holds
+packets, specs and red logs — the one recorded data loss, P1-08 r2). CLAUDE.md: "Never ...
+force-push or rewrite history". A plain push stays allowed. A `cd <module> && mvn clean` is
+blocked too (the hook does not know the directory): use `-pl <module>`.
+
+Adapted from mattpocock/skills `git-guardrails-claude-code` (MIT, ../skills/LICENSE-mattpocock-skills).
+Run as `python3 -I <this file>` (settings.json and the self-test do the same). Exit 2 = block
+(stderr is shown to the agent); exit 0 = allow.
+
+How it reads a command: a small shell lexer splits it into simple commands at ; & | ( ) ` $(
+and newlines outside quotes, joins `\\<newline>` continuations, keeps the text inside quotes as
+one word (so `"+main"` reaches the rules as `+main`), and skips heredoc bodies — from the line
+after `<<WORD` to the line `WORD` — while the rest of the `<<` line is still read. In every simple
+command the first word named `git` (at any position, so `timeout 60 git`, `xargs git`, `sudo -u u
+git` are seen) starts the call; its global options (-C, -c, --git-dir, ...) are skipped, then the
+subcommand and its arguments are checked. Long options match by git's unique-prefix rule (`--har`
+is `--hard`); combined short flags are split (`-fu`).
+
+Not seen, by design: commands hidden in `bash -c "..."`, `eval`, git aliases and scripts. Local
+branch resets by `git checkout -B` / `git switch -C` are allowed (they move only a local ref, and
+pushing the result still needs a force push, which is blocked); `git branch -f` is blocked because
+it moves a branch other than the current one silently. The hook is a guardrail against accidents,
+not a sandbox; the rule in CLAUDE.md still applies.
+"""
+import json
+import os
+import sys
+
+MESSAGE = ("BLOCKED by .claude/hooks/guard-commands.py: {why} in '{cmd}' "
+           "(CLAUDE.md: never force-push or rewrite history; never lose work). Restore a file with cp from a "
+           "pristine copy; if this is really needed, write it in the handback or an issue for the owner.")
+
+GLOBAL_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path",
+                     "--super-prefix", "--config-env", "--list-cmds"}
+WHOLE_TREE = {".", "./", ":/", ":/.", "*", ":/*"}
+SEPARATORS = set(";&|()`\n")
+
+
+class Unparsable(Exception):
+    pass
+
+
+def simple_commands(cmd):
+    """Yield the word list of every simple command; raise Unparsable on an unterminated quote."""
+    words, word, in_word = [], [], False
+    pending_heredocs = []
+    i, n = 0, len(cmd)
+
+    def end_word():
+        nonlocal word, in_word
+        if in_word:
+            words.append("".join(word))
+        word, in_word = [], False
+
+    def end_command():
+        nonlocal words
+        end_word()
+        if words:
+            out.append(words)
+        words = []
+
+    out = []
+    while i < n:
+        c = cmd[i]
+        if c == "\\" and i + 1 < n:
+            if cmd[i + 1] == "\n":
+                i += 2
+                continue
+            word.append(cmd[i + 1]); in_word = True; i += 2
+            continue
+        if c == "'":
+            j = cmd.find("'", i + 1)
+            if j < 0:
+                raise Unparsable
+            word.append(cmd[i + 1:j]); in_word = True; i = j + 1
+            continue
+        if c == '"':
+            j, buf = i + 1, []
+            while j < n and cmd[j] != '"':
+                if cmd[j] == "\\" and j + 1 < n and cmd[j + 1] in '"\\$`\n':
+                    if cmd[j + 1] != "\n":
+                        buf.append(cmd[j + 1])
+                    j += 2
+                    continue
+                buf.append(cmd[j]); j += 1
+            if j >= n:
+                raise Unparsable
+            word.append("".join(buf)); in_word = True; i = j + 1
+            continue
+        if cmd.startswith("<<<", i):
+            end_word(); i += 3
+            continue
+        if cmd.startswith("<<", i):
+            end_word()
+            i += 2
+            strip_tabs = i < n and cmd[i] == "-"
+            if strip_tabs:
+                i += 1
+            while i < n and cmd[i] in " \t":
+                i += 1
+            delim = []
+            while i < n and cmd[i] not in " \t\n;&|()<>`":
+                if cmd[i] in "'\"\\":
+                    i += 1
+                    continue
+                delim.append(cmd[i]); i += 1
+            pending_heredocs.append(("".join(delim), strip_tabs))
+            continue
+        if c in SEPARATORS:
+            end_command()
+            i += 1
+            if c == "\n" and pending_heredocs:
+                for delim, strip_tabs in pending_heredocs:
+                    while i < n:
+                        j = cmd.find("\n", i)
+                        line = cmd[i:] if j < 0 else cmd[i:j]
+                        i = n if j < 0 else j + 1
+                        if (line.lstrip("\t") if strip_tabs else line) == delim:
+                            break
+                pending_heredocs = []
+            continue
+        if c in " \t":
+            end_word(); i += 1
+            continue
+        word.append(c); in_word = True; i += 1
+    end_command()
+    nested = []
+    for ws in out:
+        for w in ws:
+            for opener in ("$(", "`"):
+                if opener in w:
+                    nested.extend(simple_commands(w.split(opener, 1)[1].replace(")", " ").replace("`", " ")))
+    return out + nested
+
+
+def git_call(words):
+    for k, w in enumerate(words):
+        if os.path.basename(w) == "git":
+            i = k + 1
+            while i < len(words) and words[i].startswith("-"):
+                i += 2 if words[i] in GLOBAL_WITH_VALUE else 1
+            if i < len(words):
+                return words[i], words[i + 1:]
+            return None
+    return None
+
+
+MVN_WITH_VALUE = {"-pl", "--projects", "-f", "--file", "-P", "--activate-profiles", "-rf", "--resume-from",
+                  "-T", "--threads", "-s", "--settings", "-gs", "--global-settings", "-l", "--log-file",
+                  "-D", "--define", "-b", "--builder", "-t", "--toolchains", "-e", "-gt"}
+
+
+def mvn_call(words):
+    for k, w in enumerate(words):
+        if os.path.basename(w) in {"mvn", "mvnw", "mvnw.cmd"}:
+            return words[k + 1:]
+    return None
+
+
+def mvn_verdict(args):
+    goals, scoped, i = [], False, 0
+    while i < len(args):
+        a = args[i]
+        if a in {"-pl", "--projects", "-f", "--file"} or a.startswith(("--projects=", "--file=")) or (
+                a.startswith("-pl") and len(a) > 3):
+            scoped = True
+        if a in MVN_WITH_VALUE:
+            i += 2
+            continue
+        if not a.startswith("-"):
+            goals.append(a)
+        i += 1
+    if not scoped and any(g == "clean" or g.startswith("clean:") for g in goals):
+        return ("`mvn clean` at the reactor root, which deletes the root target/ (packets, specs, red logs; "
+                "P1-08 r2 lost them) — clean per module: mvn -q clean -pl <module>")
+    return None
+
+
+def long_opt(args, *names):
+    for a in args:
+        if a.startswith("--") and len(a) > 2:
+            given = a.split("=", 1)[0]
+            if any(n == given or (len(given) >= 5 and n.startswith(given)) for n in names):
+                return True
+    return False
+
+
+def short_opt(args, letters):
+    return any(a.startswith("-") and not a.startswith("--") and len(a) > 1
+               and set(letters) & set(a[1:]) for a in args)
+
+
+def pathspecs(args):
+    return [a for a in args if not a.startswith("-")]
+
+
+def verdict(sub, args):
+    if sub in {"rebase", "filter-branch", "filter-repo", "replace"}:
+        return f"`git {sub}` rewrites history"
+    if sub == "push":
+        if long_opt(args, "--force", "--force-with-lease", "--force-if-includes"):
+            return "a force push"
+        if long_opt(args, "--delete", "--mirror", "--prune") or short_opt(args, "fd"):
+            return "a force push or a remote ref deletion"
+        refs = [a for a in args if not a.startswith("-")]
+        if any(r.startswith("+") or r.startswith(":") for r in refs):
+            return "a forced or deleting refspec"
+    if sub == "reset" and long_opt(args, "--hard", "--keep", "--merge"):
+        return "`git reset` discarding work"
+    if sub == "clean" and (short_opt(args, "f") or long_opt(args, "--force")):
+        return "`git clean` deleting untracked files"
+    if sub == "branch":
+        if short_opt(args, "DMfC") or long_opt(args, "--force"):
+            return "a forced branch delete, move or overwrite"
+    if sub == "checkout":
+        if short_opt(args, "f") or long_opt(args, "--force"):
+            return "a forced checkout discarding work"
+        if set(pathspecs(args)) & WHOLE_TREE:
+            return "a whole-tree checkout discarding work"
+    if sub == "restore" and set(pathspecs(args)) & WHOLE_TREE:
+        staged_only = long_opt(args, "--staged") or short_opt(args, "S")
+        worktree = long_opt(args, "--worktree") or short_opt(args, "W")
+        if not staged_only or worktree:
+            return "a whole-tree restore discarding work"
+    if sub == "switch" and (short_opt(args, "f") or long_opt(args, "--force", "--discard-changes")):
+        return "a switch discarding work"
+    if sub == "commit" and long_opt(args, "--amend"):
+        return "an amended commit"
+    if sub == "update-ref" and (short_opt(args, "d") or long_opt(args, "--delete")):
+        return "a ref deletion"
+    if sub == "reflog" and args and args[0] in {"expire", "delete"}:
+        return "a reflog rewrite"
+    if sub == "gc" and any(a.startswith("--prune") for a in args):
+        return "a pruning gc"
+    if sub == "stash" and args and args[0] in {"drop", "clear"}:
+        return "a dropped stash"
+    return None
+
+
+def main():
+    raw = sys.stdin.read()
+    try:
+        cmd = json.loads(raw)["tool_input"]["command"]
+        if not isinstance(cmd, str):
+            raise TypeError
+        commands = simple_commands(cmd)
+    except (ValueError, KeyError, TypeError, Unparsable):
+        if "git" in raw:
+            print("BLOCKED by .claude/hooks/guard-commands.py: the command could not be read "
+                  "(bad input or an unterminated quote) and it mentions git; failing closed.", file=sys.stderr)
+            return 2
+        return 0
+    for words in commands:
+        call = git_call(words)
+        why = verdict(*call) if call else None
+        mvn = mvn_call(words)
+        why = why or (mvn_verdict(mvn) if mvn is not None else None)
+        if why:
+            print(MESSAGE.format(why=why, cmd=cmd), file=sys.stderr)
+            return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/.claude/hooks/guard-commands.test.py b/.claude/hooks/guard-commands.test.py
new file mode 100755
index 0000000..43353e3
--- /dev/null
+++ b/.claude/hooks/guard-commands.test.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Self-test for guard-commands.py: every rule and alternative has a blocked case, every
+git command the workflow uses has an allowed case. Exit 0 when all match, 1 otherwise."""
+import json
+import os
+import subprocess
+import sys
+
+HOOK = os.path.join(os.path.dirname(os.path.abspath(__file__)), "guard-commands.py")
+
+BLOCKED = [
+    # push: force variants, remote deletion, mirror/prune, refspecs, combined short flags
+    "git push --force origin main", "git push -f", "git push --force-with-lease",
+    "git push --force-if-includes origin x", "git push --forc origin x", "git push -fu origin x",
+    "git push -uf origin x", "git push origin +main", "git push origin :main",
+    "git push --delete origin main", "git push -d origin x", "git push --mirror", "git push --prune origin",
+    # global options before the subcommand
+    "git -C /x push --force-with-lease", "git -c core.x=y push -f", "git --git-dir=.git push -f",
+    "git -C \"/a b\" push -f", "/usr/bin/git push -f", "GIT_TRACE=1 git push -f", "sudo git push -f",
+    # separators
+    "cd a && git push -f origin x", "true; git rebase --abort", "x=$(git push -f)", "ls | git clean -f",
+    # reset
+    "git reset --hard HEAD~1", "git reset --har HEAD", "git reset --keep HEAD~1", "git reset --merge",
+    # clean
+    "git clean -fd", "git clean -xdf", "git clean --force -d",
+    # branch
+    "git branch -D foo", "git branch -df x", "git branch -d -f x", "git branch --force --delete x",
+    "git branch --delete --force x", "git branch -f main HEAD~3", "git branch -M old new", "git branch -C a b",
+    # checkout / restore / switch
+    "git checkout .", "git checkout -- .", "git checkout ./", "git checkout :/", "git checkout -f main",
+    "git restore .", "git restore ./", "git restore :/", "git switch --discard-changes main", "git switch -f main",
+    # history rewrite
+    "git rebase main", "git filter-branch --all", "git filter-repo --path x", "git replace a b",
+    "git commit --amend --no-edit", "git commit --amen",
+    # refs, reflog, gc, stash
+    "git update-ref -d refs/heads/x", "git update-ref --delete refs/heads/x", "git reflog expire --all",
+    "git reflog delete HEAD@{1}", "git gc --prune=now", "git stash drop", "git stash clear",
+    # round 2: commands after a heredoc opener, apostrophes in double quotes, quoted git arguments,
+    # line continuation, wrappers before git, command substitution inside double quotes
+    "git commit -F - <<'EOF' && git push --force origin main\nmsg\nEOF",
+    "git commit -m \"don't\" && git push -f origin 'main'",
+    "git push origin \"+main\"", "git push origin ':main'", "git restore '*'", "git checkout -- \".\"",
+    "git restore --staged --worktree .", "git push \\\n  --force origin main",
+    "timeout 60 git push -f", "nice git push -f", "xargs git branch -D", "env -i git push -f",
+    "sudo -u u git push -f", "echo \"$(git push -f)\"", "echo `git reset --hard`",
+    "git commit -F - <<EOF\nbody\nEOF\ngit push -f", "git commit -F - <<-EOF\n\tbody\n\tEOF\ngit push -f",
+    "git commit -F - <<'EOF'\nbody\nEOF\ngit push -f", "git \\\npush -f", "cat <<< x\ngit push -f",
+    "git commit -m 'unterminated",
+    # mvn clean at the reactor root
+    "mvn clean", "mvn -B -ntp -q clean verify", "./mvnw clean install", "cd flottila-core && mvn clean",
+    "mvn clean:clean", "mvn -q -P it clean verify > target/x.log 2>&1", "timeout 900 mvn clean",
+]
+
+ALLOWED = [
+    # pushes the workflow does
+    "git push -u origin claude/festive-babbage-fy8615", "git push origin main", "git push origin HEAD:main",
+    "git push -q -u origin claude/x 2>&1 | tail -1",
+    # commits, including messages and heredoc bodies that mention forbidden commands
+    "git commit -m 'reset --hard docs'", "git commit -F msg", "rm -f target/.batch-in-review && git commit -F msg",
+    "git commit -q -F - <<'EOF'\nfix: never git push --force; the owner's rule\n\nTask: X\nEOF",
+    "git commit -m \"git push -f is blocked\"",
+    # reading and searching
+    "git status", "git log --grep force-push", "git log --grep=force-push", "grep -n force-push CLAUDE.md",
+    "git diff --stat", "git log -3 --oneline", "echo '{}'", "ls -f",
+    # files and branches
+    "git checkout -- src/Foo.java", "git checkout main", "git checkout -B claude/x origin/main",
+    "git restore src/A.java", "git restore --staged src/A.java", "git branch -d merged", "git switch main",
+    "git reset HEAD file", "git reset --soft HEAD~1", "git clean -n", "git stash", "git stash pop",
+    # scratch trees and bisect
+    "git worktree add --detach /tmp/x HEAD", "git bisect start", "git bisect reset", "git gc",
+    "git fetch origin main", "git apply --check agent/patches/x.patch",
+    # round 2 boundaries
+    "git commit -m \"don't stop\" && git push origin main",
+    "git commit -F - <<'EOF' && git push origin main\nnever git push --force here\nEOF",
+    "git commit -q -F - <<'EOF'\nthe owner's rule: git reset --hard is out\nEOF\ngit push -u origin claude/x",
+    "git restore --staged .", "timeout 60 git push -u origin main", "git push \\\n  -u origin main",
+    "echo \"$(git rev-parse HEAD)\"", "cat <<< 'git push -f'",
+    "git commit -m \"say \\\" ; git push -f here\"", "git checkout -- \"\\\\.\"",
+    # mvn: per-module clean, builds without clean, a profile or property named clean
+    "mvn -q clean -pl flottila-core", "mvn clean --projects flottila-core", "mvn clean -plflottila-core",
+    "mvn -f flottila-core/pom.xml clean", "mvn clean --file=flottila-core/pom.xml",
+    "mvn -B -ntp -q verify -Pit > target/x-verify.log 2>&1", "mvn -P clean verify", "mvn -D clean verify",
+    "mvn -fae verify", "echo \"mvn clean is blocked\"",
+]
+# Known, accepted false positive: `git`/`mvn` is looked for at any word position (so wrappers such
+# as timeout, xargs, sudo -u are seen), hence an unquoted `echo mvn clean` is blocked too.
+
+
+def run(command):
+    payload = json.dumps({"tool_input": {"command": command}})
+    try:
+        return subprocess.run([sys.executable, "-I", HOOK], input=payload, capture_output=True, text=True,
+                              timeout=10).returncode
+    except subprocess.TimeoutExpired:
+        return "timeout"
+
+
+def main():
+    failures = [f"want 2 got {r}: {c!r}" for c in BLOCKED if (r := run(c)) != 2]
+    failures += [f"want 0 got {r}: {c!r}" for c in ALLOWED if (r := run(c)) != 0]
+    for bad in ('{"tool_input":{"command":["git","push","-f"]}}', '{"tool_input":{"cmd":"git push -f"}}','{"x":"git"}'):
+        proc = subprocess.run([sys.executable, "-I", HOOK], input=bad, capture_output=True, text=True)
+        if proc.returncode != 2:
+            failures.append(f"malformed input mentioning git not blocked: {bad}")
+    if run("git commit -m \"unterminated") != 2:
+        failures.append("an unterminated quote with git is not blocked")
+    proc = subprocess.run([sys.executable, "-I", HOOK], input="not json, git push", capture_output=True, text=True)
+    if proc.returncode != 2:
+        failures.append("unparsable input mentioning git is not blocked")
+    proc = subprocess.run([sys.executable, "-I", HOOK], input="not json", capture_output=True, text=True)
+    if proc.returncode != 0:
+        failures.append("unparsable input without git is blocked")
+    for f in failures:
+        print("FAIL", f)
+    if not failures:
+        print(f"guard-commands: all {len(BLOCKED)} blocked and {len(ALLOWED)} allowed cases pass")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
