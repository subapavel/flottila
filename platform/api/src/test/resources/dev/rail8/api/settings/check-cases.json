{
  "comment": "Cases of the settings check over one description, run by the platform's check and by the UI's form, so the two judge alike. Each case: an endpoint's options, its direction, and the problems in their order.",
  "description": {
    "format": 1,
    "described": true,
    "tabs": [
      { "id": "general", "label": "General", "common": true },
      { "id": "polling", "label": "Polling", "common": false },
      { "id": "retry", "label": "Retry", "common": true },
      { "id": "recording", "label": "Recording", "common": true },
      { "id": "security", "label": "Security", "common": true }
    ],
    "fields": [
      { "name": "host", "type": "text", "help": "The server.", "tab": "general", "required": false, "directions": ["in", "out"] },
      { "name": "port", "type": "integer", "help": "The server's port.", "tab": "general", "required": false, "directions": ["in", "out"], "default": 22, "min": 1, "max": 65535 },
      { "name": "user", "type": "text", "help": "The login.", "tab": "security", "required": true, "directions": ["in", "out"] },
      { "name": "password", "type": "secret", "help": "The password, or set privateKey.", "tab": "security", "required": false, "directions": ["in", "out"] },
      { "name": "privateKey", "type": "secret", "help": "The private key, or set password.", "tab": "security", "required": false, "directions": ["in", "out"] },
      { "name": "hostKey", "type": "text", "help": "The server key's fingerprint.", "tab": "security", "required": true, "directions": ["in", "out"], "pattern": "SHA256:[A-Za-z0-9+/]+=*" },
      { "name": "afterSuccess", "type": "choice", "help": "What happens to a delivered file.", "tab": "polling", "required": false, "directions": ["in"], "default": "delete", "choices": ["delete", "move"] },
      { "name": "moveTo", "type": "text", "help": "Where a delivered file goes.", "tab": "polling", "required": true, "directions": ["in"], "visibleWhen": { "field": "afterSuccess", "values": ["move"] } },
      { "name": "archive", "type": "boolean", "help": "Whether a moved file is also archived.", "tab": "polling", "required": false, "directions": ["in"], "visibleWhen": { "field": "afterSuccess", "values": ["move"] } },
      { "name": "archiveDir", "type": "text", "help": "Where archived files go.", "tab": "polling", "required": true, "directions": ["in"], "visibleWhen": { "field": "archive", "values": [true] } },
      { "name": "url", "type": "text", "help": "Where a producer sends.", "tab": "general", "required": false, "directions": ["out"] }
    ],
    "rules": [{ "kind": "exactlyOne", "fields": ["password", "privateKey"] }]
  },
  "cases": [
    { "name": "valid options", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U" }, "problems": [] },
    { "name": "a field shown by a choice, set", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "host": "sftp", "port": 2222, "afterSuccess": "move", "moveTo": "/done" }, "problems": [] },
    { "name": "the other of exactly one", "direction": "in", "options": { "user": "rail8", "privateKey": "-----BEGIN KEY-----", "hostKey": "SHA256:zuCbj2cX0buHOs3U" }, "problems": [] },
    { "name": "a required field left out", "direction": "in", "options": { "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U" }, "problems": [{ "path": "/user", "message": "is required" }] },
    { "name": "a field shown by another is required while shown", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "afterSuccess": "move" }, "problems": [{ "path": "/moveTo", "message": "is required when afterSuccess is move" }] },
    { "name": "hidden, it is not required", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "afterSuccess": "delete" }, "problems": [] },
    { "name": "visibility is transitive: hidden by a hidden field", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "archive": true }, "problems": [] },
    { "name": "visibility is transitive: shown", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "archive": true, "afterSuccess": "move", "moveTo": "/done" }, "problems": [{ "path": "/archiveDir", "message": "is required when archive is true" }] },
    { "name": "a hidden field may be set", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "moveTo": "/done" }, "problems": [] },
    { "name": "a hidden field is still checked", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "moveTo": 7 }, "problems": [{ "path": "/moveTo", "message": "must be text" }] },
    { "name": "unknown keys in name order", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "pasword": "typo", "colour": "red" }, "problems": [{ "path": "/colour", "message": "no such setting" }, { "path": "/pasword", "message": "no such setting" }] },
    { "name": "a key of out endpoints on an in one", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "url": "http://x" }, "problems": [{ "path": "/url", "message": "a setting of out endpoints only" }] },
    { "name": "a key of in endpoints on an out one", "direction": "out", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "afterSuccess": "move" }, "problems": [{ "path": "/afterSuccess", "message": "a setting of in endpoints only" }] },
    { "name": "the node's keys on an in endpoint", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "flow": "orders/intake", "maxBodyBytes": 1000000 }, "problems": [] },
    { "name": "the node's keys on an out endpoint", "direction": "out", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "flow": "orders/intake", "maxBodyBytes": 1000000 }, "problems": [{ "path": "/flow", "message": "no such setting" }, { "path": "/maxBodyBytes", "message": "no such setting" }] },
    { "name": "none of exactly one", "direction": "in", "options": { "user": "rail8", "hostKey": "SHA256:zuCbj2cX0buHOs3U" }, "problems": [{ "path": "", "message": "set exactly one of password, privateKey" }] },
    { "name": "both of exactly one", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "privateKey": "k", "hostKey": "SHA256:zuCbj2cX0buHOs3U" }, "problems": [{ "path": "", "message": "set exactly one of password, privateKey" }] },
    { "name": "a number as text", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "host": 7 }, "problems": [{ "path": "/host", "message": "must be text" }] },
    { "name": "text as a whole number", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": "22" }, "problems": [{ "path": "/port", "message": "must be a whole number from 1 to 65535" }] },
    { "name": "a fraction as a whole number", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": 2.5 }, "problems": [{ "path": "/port", "message": "must be a whole number from 1 to 65535" }] },
    { "name": "a whole number with a fraction of zero", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": 22.0 }, "problems": [] },
    { "name": "below the range", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": 0 }, "problems": [{ "path": "/port", "message": "must be a whole number from 1 to 65535" }] },
    { "name": "above the range", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": 65536 }, "problems": [{ "path": "/port", "message": "must be a whole number from 1 to 65535" }] },
    { "name": "the ends of the range", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": 65535 }, "problems": [] },
    { "name": "text as true or false", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "archive": "yes" }, "problems": [{ "path": "/archive", "message": "must be true or false" }] },
    { "name": "a value no choice has", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "afterSuccess": "copy" }, "problems": [{ "path": "/afterSuccess", "message": "must be one of delete, move" }] },
    { "name": "a list as a secret", "direction": "in", "options": { "user": "rail8", "password": ["s3cret"], "hostKey": "SHA256:zuCbj2cX0buHOs3U" }, "problems": [{ "path": "/password", "message": "must be text" }] },
    { "name": "the empty string is no value", "direction": "in", "options": { "user": "", "password": "", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "host": "" }, "problems": [{ "path": "/host", "message": "must not be empty" }, { "path": "/user", "message": "must not be empty" }, { "path": "/password", "message": "must not be empty" }] },
    { "name": "null is absent", "direction": "in", "options": { "user": null, "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "host": null }, "problems": [{ "path": "/user", "message": "is required" }] },
    { "name": "a pattern matches the whole value", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "x SHA256:abc" }, "problems": [{ "path": "/hostKey", "message": "must match SHA256:[A-Za-z0-9+/]+=*" }] },
    { "name": "a pattern is case-sensitive", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "sha256:abc" }, "problems": [{ "path": "/hostKey", "message": "must match SHA256:[A-Za-z0-9+/]+=*" }] },
    { "name": "a secret reference stands in for any text", "direction": "in", "options": { "user": "rail8", "password": "secret://sftp.password_2", "hostKey": "secret://sftp-host-key" }, "problems": [] },
    { "name": "a malformed reference is plain text", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "secret://UPPER" }, "problems": [{ "path": "/hostKey", "message": "must match SHA256:[A-Za-z0-9+/]+=*" }] },
    { "name": "only text and secrets take a reference", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "port": "secret://port" }, "problems": [{ "path": "/port", "message": "must be a whole number from 1 to 65535" }] },
    { "name": "fields first, then unknown keys, then groups", "direction": "in", "options": { "zebra": 1, "hostKey": "nope", "port": 0 }, "problems": [{ "path": "/port", "message": "must be a whole number from 1 to 65535" }, { "path": "/user", "message": "is required" }, { "path": "/hostKey", "message": "must match SHA256:[A-Za-z0-9+/]+=*" }, { "path": "/zebra", "message": "no such setting" }, { "path": "", "message": "set exactly one of password, privateKey" }] },
    { "name": "a key is a JSON pointer", "direction": "in", "options": { "user": "rail8", "password": "s3cret", "hostKey": "SHA256:zuCbj2cX0buHOs3U", "a/b~c": 1 }, "problems": [{ "path": "/a~1b~0c", "message": "no such setting" }] }
  ]
}
