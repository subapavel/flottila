<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.rail8</groupId>
    <artifactId>rail8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>rail8-cli</artifactId>
  <packaging>jar</packaging>
  <name>Rail8 :: cli</name>
  <description>rail8 validate | test | deploy: the outermost module, nothing depends on it (D-079).</description>

  <build>
    <plugins>
      <plugin>
        <!-- the template of `rail8 new-adapter`: the sample adapter's build, sources and package, in the jar under
             adapter-template/; its target folder is left out -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>adapter-template</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/adapter-template</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../examples/webhook-plugin</directory>
                  <includes>
                    <include>pom.xml</include>
                    <include>src/**</include>
                    <include>package/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- a temporary directory for each test JVM, so a test that lists java.io.tmpdir sees only its own JVM's files;
               ForkTempDir creates it -->
          <argLine>@{argLine} -Drail8.test.fork=${surefire.forkNumber} -Djava.io.tmpdir=${project.build.directory}/tmp/fork-${surefire.forkNumber}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <!-- the runnable cli (D-079): `java -jar target/rail8-cli-<v>.jar` (bin/rail8) runs Cli; the manifest names it and a
             lib/ class path, which copy-dependencies below fills, as rail8-runtime's jar does; no shading -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.rail8.cli.Cli</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <useUniqueVersions>false</useUniqueVersions>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- the jar's runtime class path next to it, in target/lib; Apache-2.0 -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-classpath</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-api</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-testkit</artifactId>
    </dependency>
    <!-- cli is the outermost module (F-16, D-079): the node's Deployments and what Main.shipped() wires (components, steps) -->
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-schemas</artifactId>
    </dependency>
    <!-- the mock component, for the flow-test runner (P2-03b); a node never loads it (runtime does not depend on it) -->
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-mock</artifactId>
    </dependency>
    <!-- DeployCommandIT: a node in this JVM on a Testcontainers Postgres (-Pit) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ForkTempDir: creates each test JVM's temporary directory when the test run opens -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
