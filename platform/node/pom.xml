<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.rail8</groupId>
    <artifactId>rail8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>rail8-node</artifactId>
  <packaging>jar</packaging>
  <name>Rail8 :: node</name>
  <description>The node's distribution: the runtime and the components and step modules that ship with it. No code of its own.</description>

  <build>
    <plugins>
      <plugin>
        <!-- `java -jar target/rail8-node-<v>.jar` starts a node: the jar holds only a manifest, which names Main and a lib/
             class path that copy-dependencies below fills; no shading. -SNAPSHOT names, as copy-dependencies writes them. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>false</skipIfEmpty>
          <archive>
            <manifest>
              <mainClass>dev.rail8.runtime.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <useUniqueVersions>false</useUniqueVersions>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- the jar's runtime class path next to it, in target/lib (deploy/quickstart/Dockerfile copies both); Apache-2.0 -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-classpath</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-runtime</artifactId>
    </dependency>
    <!-- the shipped modules, at runtime scope: on the node's class path and in target/lib, where the node finds them as
         modules. Every module of the platform is here (BuildHygieneTest). -->
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-direct</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-http</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-sftp</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-jq</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-mapping</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-validate</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-xslt</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- NodeJarIT starts the packaged jar on a Testcontainers Postgres (-Pit) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
