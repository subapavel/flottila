<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.rail8</groupId>
    <artifactId>rail8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>rail8-runtime</artifactId>
  <packaging>jar</packaging>
  <name>Rail8 :: runtime</name>
  <description>Vert.x bootstrap, endpoint verticles, Postgres stores, the body journal, Valkey poller leases, the S3 deployment archive store, admin API.</description>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <!-- deploy/postgres is the single source of the migrations: ops apply them by file, the runtime from the classpath -->
      <resource>
        <directory>${project.basedir}/../../deploy/postgres</directory>
        <targetPath>db/migration</targetPath>
        <includes><include>V*.sql</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- artifacts the tests need as files of their own; Apache-2.0 -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <!-- the sample plugin's jar, for WebhookPluginIT's RAIL8_PLUGINS; it stays off the tests' class path (below), where
                 the node would find it as a module of its own build -->
            <id>copy-test-plugins</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/test-plugins</outputDirectory>
              <includeArtifactIds>rail8-plugin-webhook</includeArtifactIds>
              <stripVersion>true</stripVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- *HeapTest run in their own JVM with a heap far below the body they stream: a store that holds the body at once
             fails with OutOfMemoryError, deterministically, instead of a GC heuristic deciding (P1-01 review). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes><exclude>**/*HeapTest.java</exclude></excludes>
          <classpathDependencyExcludes><classpathDependencyExclude>dev.rail8.examples:rail8-plugin-webhook</classpathDependencyExclude></classpathDependencyExcludes>
        </configuration>
        <executions>
          <execution>
            <id>heap-bounded</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <excludes><exclude>none</exclude></excludes>
              <includes><include>**/*HeapTest.java</include></includes>
              <argLine>@{argLine} -Xmx48m</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <classpathDependencyExcludes><classpathDependencyExclude>dev.rail8.examples:rail8-plugin-webhook</classpathDependencyExclude></classpathDependencyExcludes>
        </configuration>
      </plugin>
      <plugin>
        <!-- MainProcessIT runs Main in a JVM of its own with the JaCoCo agent writing jacoco-main-process.exec (P1-09d3): merged
             with the tests' jacoco.exec so the report and the floors count Main's lines. The merge skips a file that is absent
             (no -Pit run) and writes nothing when neither exists; the report then skips as it does without data. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>merge-main-process</id>
            <phase>post-integration-test</phase>
            <goals><goal>merge</goal></goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco.exec</include>
                    <include>jacoco-main-process.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
            </configuration>
          </execution>
          <execution>
            <id>check-floors</id>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-pg-client</artifactId>
    </dependency>
    <!-- the admin API's Router (D-057 a); version from vertx-stack-depchain, EPL-2.0 / Apache-2.0 (vertx-web-5.1.10.pom) -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web</artifactId>
    </dependency>
    <!-- poller leases in Valkey (D-083, P2-02L); version from vertx-stack-depchain -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-redis-client</artifactId>
    </dependency>
    <!-- journal.peer.PeerLink resets a superseded repl link's socket on its channel (CORE-5b1, FIX-180); version from the
         netty-bom vertx-stack-depchain imports (4.2.19.Final), Apache-2.0 (netty-transport-4.2.19.Final.pom) -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the sample adapter plugin: WebhookPluginIT starts a node with its jar, copied to target/test-plugins, in RAIL8_PLUGINS -->
      <groupId>dev.rail8.examples</groupId>
      <artifactId>rail8-plugin-webhook</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- EmbeddedSftp for the two-node lease test (P2-02L) -->
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-sftp</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- runtime.node validates packages with the schemas -->
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-schemas</artifactId>
    </dependency>
    <!-- the shipped modules, at test scope: the tests start nodes that find them as modules. The node's distribution,
         platform/node, brings them; no runtime class can name one. -->
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-xslt</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-validate</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-jq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-step-mapping</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-http</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-sftp</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.rail8</groupId>
      <artifactId>rail8-component-direct</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- schema migrations at start (D-034): Flyway community + its Postgres module; Flyway needs JDBC, so the
         driver is a runtime dependency for this one purpose — everything else goes through the Vert.x client -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- *IT classes run under -Pit against Testcontainers Postgres -->
    <dependency>
      <!-- S3 tier: the synchronous S3 client over the JDK's HttpURLConnection; blocking calls run on the message's virtual thread -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion>
        <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- S3 API for the tier's IT: LocalStack (Apache-2.0 image) through the official module (MIT) -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the node's one SLF4J provider: Netty, the AWS SDK, MINA SSHD and custom code log through java.util.logging -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
