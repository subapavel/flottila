<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.rail8</groupId>
  <artifactId>rail8-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Rail8</name>
  <description>Open-source enterprise integration platform where monitoring is the product.</description>
  <url>https://github.com/subapavel/flottila</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <!-- Dependency direction (enforced by rail8-archtest): api <- core <- runtime;
       components and steps depend on api only; testkit on api (F-1); core's tests use the testkit; cli on api + testkit. -->
  <modules>
    <module>api</module>
    <module>testkit</module>
    <module>core</module>
    <module>runtime</module>
    <module>components</module>
    <module>steps</module>
    <module>schemas</module>
    <module>cli</module>
    <module>sim</module>
    <module>archtest</module>
    <module>../bench</module>   <!-- the bench harness lives beside its scripts in the root bench/ (D-149) -->
    <!-- the sample adapter plugin, a build of its own over the kit: built here so that its tests run and a node's test loads it -->
    <module>../examples/webhook-plugin</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- libraries (all Apache-2.0 / EPL-2.0 / MIT / BSD; CLAUDE.md licence rule) -->
    <vertx.version>5.1.10</vertx.version>
    <junit.version>5.14.4</junit.version>
    <jqwik.version>1.10.2</jqwik.version>
    <rail8-jq.version>0.1.0-SNAPSHOT</rail8-jq.version>
    <rail8-mapping.version>0.1.0-SNAPSHOT</rail8-mapping.version>
    <archunit.version>1.5.1</archunit.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <slf4j.version>2.0.17</slf4j.version>
    <postgresql-jdbc.version>42.7.14</postgresql-jdbc.version> <!-- BSD-2-Clause; runtime scope, for Flyway only -->
    <flyway.version>13.10.3</flyway.version>
    <sshd.version>2.20.0</sshd.version> <!-- Apache-2.0: Apache MINA SSHD, the sftp component's client (D-076) -->
    <saxon.version>12.4</saxon.version> <!-- MPL-2.0 (allowed, CLAUDE.md); its one required dependency xmlresolver is Apache-2.0 --> <!-- Apache-2.0 (community); flyway-database-postgresql carries the Postgres support since Flyway 10 -->

    <!-- plugins -->
    <maven-compiler.version>3.14.1</maven-compiler.version>
    <errorprone.version>2.52.0</errorprone.version> <!-- Apache-2.0: Error Prone, the static analysis javac runs -->
    <maven-surefire.version>3.6.0</maven-surefire.version>
    <maven-jar.version>3.4.2</maven-jar.version>
    <maven-resources.version>3.3.1</maven-resources.version>
    <maven-enforcer.version>3.6.3</maven-enforcer.version>
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.30.1</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>

    <!-- coverage floors (CLAUDE.md): api/core 90 %, everything else 75 %, line and branch.
         Modules override rail8.coverage.* -->
    <rail8.coverage.line>0.75</rail8.coverage.line>
    <rail8.coverage.branch>0.75</rail8.coverage.branch>
    <!-- PIT mutation floor for api and core (phase-gate condition) -->
    <rail8.mutation.threshold>80</rail8.mutation.threshold>

    <!-- surefire: JaCoCo's prepare-agent prepends its -javaagent to this property -->
    <argLine></argLine>
    <!-- test JVMs run side by side, one per core: test classes of one module are spread over them. -Drail8.test.forks=1 runs
         them one after another. -->
    <rail8.test.forks>1C</rail8.test.forks>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- reactor modules -->
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-component-http</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-component-mock</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-component-sftp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-step-xslt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-step-validate</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-step-jq</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- The jq engine (Apache-2.0), built from jq/ and installed by bin/install-jq before the platform is built -->
      <dependency>
        <groupId>dev.rail8.jq</groupId>
        <artifactId>rail8-jq-core</artifactId>
        <version>${rail8-jq.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-step-mapping</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- The mapping engine's embedding API (Apache-2.0), built from mapping/ and installed by bin/install-mapping before the
           platform is built; the engine's licences are checked by the mapping's own build -->
      <dependency>
        <groupId>dev.rail8.mapping</groupId>
        <artifactId>rail8-mapping-embed</artifactId>
        <version>${rail8-mapping.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-sim</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-schemas</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.rail8</groupId>
        <artifactId>rail8-bench</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-stack-depchain</artifactId>
        <version>${vertx.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- S3 tier of the BlobStore (P1-01): AWS SDK v2, Apache-2.0; only runtime may depend on it (ArchUnit) -->
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.56.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- YAML flow/package/endpoint/test files (P0-12): Jackson's YAML module, Apache-2.0 (SnakeYAML inside, Apache-2.0) -->
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.22.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- XSLT 3.0 / XPath 3.1 for the xslt step (Saxon-HE) -->
        <groupId>net.sf.saxon</groupId>
        <artifactId>Saxon-HE</artifactId>
        <version>${saxon.version}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.sshd</groupId>
        <artifactId>sshd-core</artifactId>
        <version>${sshd.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.sshd</groupId>
        <artifactId>sshd-sftp</artifactId>
        <version>${sshd.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-core</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-database-postgresql</artifactId>
        <version>${flyway.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <!-- Error Prone runs inside javac on main and test sources. A check of severity ERROR fails the build;
                 a WARNING is only printed. It needs the javac internals opened in .mvn/jvm.config. -->
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial</arg>
              <arg>-XDcompilePolicy=simple</arg>
              <arg>--should-stop=ifError=FLOW</arg>
              <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
              <arg>-Xplugin:ErrorProne</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${errorprone.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire.version}</version>
          <configuration>
            <!-- each fork draws test ports from a slice of its own (dev.rail8.testkit.Ports) -->
            <argLine>@{argLine} -Drail8.test.fork=${surefire.forkNumber}</argLine>
            <forkCount>${rail8.test.forks}</forkCount>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-surefire.version}</version>
          <configuration>
            <!-- each fork draws test ports from a slice of its own (dev.rail8.testkit.Ports) -->
            <argLine>@{argLine} -Drail8.test.fork=${surefire.forkNumber}</argLine>
            <forkCount>${rail8.test.forks}</forkCount>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar.version}</version>
          <configuration>
            <!-- archtest and (until P0-12) schemas have nothing to package -->
            <skipIfEmpty>true</skipIfEmpty>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals><goal>report</goal></goals>
            </execution>
            <execution>
              <id>check-floors</id>
              <phase>verify</phase>
              <goals><goal>check</goal></goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${rail8.coverage.line}</minimum>
                      </limit>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${rail8.coverage.branch}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <!-- not bound to a phase: `mvn -pl :rail8-api,:rail8-core org.pitest:pitest-maven:mutationCoverage`
               (nightly `mutation` CI job, scoped runs per task for the reviewer) -->
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <targetClasses><param>dev.rail8.*</param></targetClasses>
            <targetTests><param>dev.rail8.*</param></targetTests>
            <mutationThreshold>${rail8.mutation.threshold}</mutationThreshold>
            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
            <timestampedReports>false</timestampedReports>
            <threads>4</threads>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Testcontainers tests: *IT classes; the `build` CI job runs `verify -Pit` so they count towards the floors (D-030) -->
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <!-- Two runs: every IT class not tagged "serial" on the parallel test JVMs, then the classes tagged "serial" (a
                 measurement of CPU or time that other tests on the same cores would skew) in one JVM, with no other test of
                 the module running. verify fails the build on a failure of either. -->
            <executions>
              <execution>
                <id>integration-test</id>
                <goals><goal>integration-test</goal></goals>
                <configuration>
                  <excludedGroups>serial</excludedGroups>
                </configuration>
              </execution>
              <execution>
                <id>integration-test-serial</id>
                <goals><goal>integration-test</goal></goals>
                <configuration>
                  <groups>serial</groups>
                  <forkCount>1</forkCount>
                  <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-serial.xml</summaryFile>
                </configuration>
              </execution>
              <execution>
                <id>verify</id>
                <goals><goal>verify</goal></goals>
                <configuration>
                  <!-- read besides the default failsafe-summary.xml of the first run -->
                  <summaryFiles>
                    <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-serial.xml</summaryFile>
                  </summaryFiles>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
