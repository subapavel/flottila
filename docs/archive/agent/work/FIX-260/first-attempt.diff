+    // ---- FIX-260: a start whose first pooled statement waits on a connect longer than the wait ---------------------------------
+
+    /**
+     * FIX-260 (the CI sighting of {@link #aClaimRefusedByTheWorkPoolLeavesTheWorkerRunningAndItClaimsTheQueuedItemAfterTheRelease},
+     * staged): the node's Postgres is a {@link PgWire} relay in front of the class's server, holding the next connection it accepts
+     * before its startup message reaches the server — the intake pool's connect for the start's first pooled statement (the
+     * durability check) is in progress until the hold ends, longer than the {@code RAIL8_PG_POOL_WAIT} PT0.2S the node starts
+     * under. The fixture's start still starts the node, and the node answers on its admin port.
+     */
+    @Test
+    void aStartWhoseFirstConnectOutlastsTheWaitStillStartsItsNode() throws Exception {
+        try (PgWire wire = new PgWire(pg.getHost(), pg.getMappedPort(5432)); HttpClient client = NodeIT.http()) {
+            PgWire.Held connect = wire.holdNextConnection();   // one connection only: every later one goes through at once
+            try {
+                Node node = startNode(env("RAIL8_PG_HOST", "127.0.0.1", "RAIL8_PG_PORT", String.valueOf(wire.port()), "RAIL8_PG_POOL_WAIT", "PT0.2S"));
+                connect.awaitReached();   // witness: the relay did hold a connection of this start
+                HttpResponse<String> health = client.send(get(node.adminPort(), "/health"), HttpResponse.BodyHandlers.ofString());
+                assertEquals(200, health.statusCode(), "the node started through the relay answers on its admin port: " + health.body());
+            } finally {
+                connect.releaseQuietly();
+                for (Node n : nodes) OnVirtualThread.call(() -> { n.close(); return null; });   // FIX-231: closed while the relay is up
+                nodes.clear();
+            }
+        }
+    }
