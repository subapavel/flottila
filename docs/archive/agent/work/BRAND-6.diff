+++ b/site/style.css
@@ -0,0 +1,200 @@
+/* rail8.dev - one column, system fonts, light and dark by prefers-color-scheme.
+   Palette from docs/brand: blue #0066cc and near-black #151515 (rail8-logo.svg), light blue #92c5f9
+   (rail8-logo-dark.svg). Every text/background pair below is at WCAG AA or better. */
+
+:root {
+  color-scheme: light dark;
+  --bg: #ffffff;
+  --surface: #f2f6fb;
+  --text: #151515;
+  --muted: #4d4d4d;
+  --accent: #0066cc;
+  --on-accent: #ffffff;
+  --rule: #d5dde8;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #151515;
+    --surface: #1d232b;
+    --text: #f2f2f2;
+    --muted: #b3b3b3;
+    --accent: #92c5f9;
+    --on-accent: #151515;
+    --rule: #2e3540;
+  }
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+}
+
+body {
+  margin: 0 auto;
+  max-width: 44rem;
+  padding: 3rem 1.25rem 2rem;
+  background: var(--bg);
+  color: var(--text);
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  font-size: 1.0625rem;
+  line-height: 1.6;
+}
+
+h1,
+h2 {
+  line-height: 1.25;
+}
+
+h1 {
+  margin: 0;
+}
+
+h2 {
+  margin: 0 0 0.5rem;
+  font-size: 1.125rem;
+  letter-spacing: 0.01em;
+}
+
+p {
+  margin: 0 0 0.75rem;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 0.15em;
+}
+
+a:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 3px;
+  border-radius: 4px;
+}
+
+/* The logo's "r" starts 9.02 units into its 188-unit view box; the negative margin lines it up with the text. */
+.logo {
+  display: block;
+  width: min(13rem, 70vw);
+  height: auto;
+  margin-left: calc(min(13rem, 70vw) * -9.02 / 188);
+}
+
+.home {
+  display: inline-block;
+}
+
+.hero {
+  padding-bottom: 2rem;
+  border-bottom: 1px solid var(--rule);
+}
+
+.lead {
+  margin: 1.75rem 0 1.75rem;
+  font-size: 1.3rem;
+  line-height: 1.5;
+}
+
+.links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.button {
+  display: inline-block;
+  padding: 0.55rem 1rem;
+  border: 2px solid var(--accent);
+  border-radius: 6px;
+  color: var(--accent);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.button:hover {
+  background: var(--surface);
+}
+
+.button.primary {
+  background: var(--accent);
+  color: var(--on-accent);
+}
+
+.button.primary:hover {
+  background: var(--accent);
+  text-decoration: underline;
+}
+
+main {
+  padding: 1.5rem 0 0.5rem;
+}
+
+main h1 {
+  margin: 0 0 0.75rem;
+}
+
+main section {
+  margin: 0 0 1.75rem;
+}
+
+.stack {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  margin: 0 0 0.75rem;
+  padding: 0;
+  list-style: none;
+}
+
+.stack li {
+  padding: 0.2rem 0.7rem;
+  border: 1px solid var(--rule);
+  border-radius: 999px;
+  background: var(--surface);
+  font-size: 0.95rem;
+}
+
+.status {
+  padding: 1rem 1.25rem 0.35rem;
+  border-left: 4px solid var(--accent);
+  border-radius: 0 6px 6px 0;
+  background: var(--surface);
+}
+
+footer {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  padding-top: 1.25rem;
+  border-top: 1px solid var(--rule);
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+footer p {
+  margin: 0;
+}
+
+.mark {
+  display: block;
+  width: 24px;
+  height: 24px;
+}
+
+@media (max-width: 30rem) {
+  body {
+    padding-top: 2rem;
+  }
+
+  .lead {
+    font-size: 1.15rem;
+  }
+}
