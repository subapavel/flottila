+    print(f"namespace: {len(plan)} git mv, {rewritten} file(s) rewritten, {counts['lines']} line(s)"
+          + "".join(f", {k} {v}" for k, v in sorted(counts.items()) if k != "lines") + f"; {len(reported)} reported")
