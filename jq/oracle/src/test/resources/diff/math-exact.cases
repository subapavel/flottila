filter [[0, 0*-1, 1, -1, 1.5, 5e-324, 2.2250738585072014e-308, 1.7976931348623157e308, infinite, -infinite, nan, -nan][] as $x | [0, 1, -1, 2.5, -2.5, 1023, 1024, -1074, -1075, 2147483647, 2147483648, -2147483648, -2147483649, 9223372036854775807, -9223372036854775808, 1e300, -1e300, infinite, -infinite, nan][] as $n | copysign(1; scalb($x; $n))]
stdin null\n
end

case math-exact/scalbln
arg -c
filter [[0, 0*-1, 1, -1, 1.5, 5e-324, 2.2250738585072014e-308, 1.7976931348623157e308, infinite, -infinite, nan, -nan][] as $x | [0, 1, -1, 2.5, -2.5, 1023, 1024, -1074, -1075, 2147483647, 2147483648, -2147483648, -2147483649, 9223372036854775807, -9223372036854775808, 1e300, -1e300, infinite, -infinite, nan][] as $n | scalbln($x; $n)]
stdin null\n
end

case math-exact/scalbln-signs
arg -c
filter [[0, 0*-1, 1, -1, 1.5, 5e-324, 2.2250738585072014e-308, 1.7976931348623157e308, infinite, -infinite, nan, -nan][] as $x | [0, 1, -1, 2.5, -2.5, 1023, 1024, -1074, -1075, 2147483647, 2147483648, -2147483648, -2147483649, 9223372036854775807, -9223372036854775808, 1e300, -1e300, infinite, -infinite, nan][] as $n | copysign(1; scalbln($x; $n))]
stdin null\n
end

case math-exact/fma
arg -c
filter [[0, 0*-1, 1, -1, 2, infinite, -infinite, nan, -nan][] as $x | [0, 0*-1, 1, -1, 2, infinite, -infinite, nan, -nan][] as $y | [0, 0*-1, 1, -1, 2, infinite, -infinite, nan, -nan][] as $z | fma($x; $y; $z)]
stdin null\n
end

case math-exact/fma-signs
arg -c
filter [[0, 0*-1, 1, -1, 2, infinite, -infinite, nan, -nan][] as $x | [0, 0*-1, 1, -1, 2, infinite, -infinite, nan, -nan][] as $y | [0, 0*-1, 1, -1, 2, infinite, -infinite, nan, -nan][] as $z | copysign(1; fma($x; $y; $z))]
stdin null\n
end

case math-exact/fma-rounds-once
arg -c
filter [fma(0.1; 10; -1), fma(1 + 1/4503599627370496; 1 - 1/4503599627370496; -1), fma(1e308; 10; -1e309)]
stdin null\n
end

case math-exact/round-half-cases
arg -c
filter [0.49999999999999994, -0.49999999999999994, 4503599627370495.5, -4503599627370495.5, 4503599627370496.5, 0.5, 1.5, 2.5, -0.5] | map([round, rint, nearbyint, trunc, floor, ceil])
stdin null\n
end

case math-exact/fmod-remainder-signs
arg -c
filter [[5, 3], [-5, 3], [5, -3], [-5, -3], [5.5, 2], [6, 4], [-6, 4], [1e300, 3], [3, 1e300], [5e-324, 3]] | map([fmod(.[0]; .[1]), remainder(.[0]; .[1]), drem(.[0]; .[1])])
stdin null\n
end

case math-exact/nextafter-steps
arg -c
filter [nextafter(1; 2), nextafter(1; 0), nextafter(0; 1), nextafter(0; -1), nextafter(5e-324; 0), nextafter(1.7976931348623157e308; infinite), nexttoward(1; 2), nexttoward(0; -1), nexttoward(-1.7976931348623157e308; -infinite)]
stdin null\n
end
