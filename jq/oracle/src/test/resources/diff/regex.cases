arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "(?<1a>a)", "f": null}\n
end

case regex/error-undefined-name
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "\\\\k<x>", "f": null}\n
end

case regex/error-undefined-call-name
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "\\\\g<x>", "f": null}\n
end

case regex/error-multiplex-call
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "(?<n>a)(?<n>b)\\\\g<n>", "f": null}\n
end

case regex/error-never-ending-recursion
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "(?<n>a|\\\\g<n>b)", "f": null}\n
end

# Deviation (DEVIATIONS "Regex dialect"): joni's text names the property in angle brackets
case regex/error-invalid-property
deviation regex-property-name-text
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "\\\\p{Foo}", "f": null}\n
engine-stdout "Regex failure: invalid character property name <Foo>"\n
end

# Deviation (DEVIATIONS "Regex dialect"): joni has no callouts: the pattern fails to compile with another text
case regex/error-invalid-callout-pattern
deviation regex-callout
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "(?{a", "f": null}\n
engine-stdout "Regex failure: undefined group option"\n
end

# Deviation (DEVIATIONS "Regex dialect"): joni has no callouts: the pattern fails to compile with another text
case regex/error-undefined-callout-name
deviation regex-callout
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "(*FOO)", "f": null}\n
engine-stdout "Regex failure: target of repeat operator is not specified"\n
end

# Deviation (DEVIATIONS "Regex dialect"): joni has no callouts: the pattern fails to compile with another text
case regex/error-invalid-callout-tag
deviation regex-callout
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "(?{a}[1])", "f": null}\n
engine-stdout "Regex failure: undefined group option"\n
end

# Deviation (DEVIATIONS "Regex dialect"): joni has no \N, \O or \o{...}: it reads the escape as the letter
case regex/error-octal-too-long
deviation regex-escape-as-letter
arg -c
filter .re as $re | .f as $f | .s | try [match($re; $f)] catch .
stdin {"s": "abc", "re": "\\\\o{8}", "f": null}\n
engine-stdout []\n
end

case regex/prelude-test
arg -c
filter .s | [test("b"), test("B"; "i"), test(["B", "i"]), test("x")]
stdin {"s": "abc"}\n
end

case regex/prelude-match-array
arg -c
filter .s | [match(["(b)", "g"])]
stdin {"s": "abab"}\n
end

case regex/prelude-capture
arg -c
filter .s | capture("(?<y>[0-9]+)-(?<m>[0-9]+)")
stdin {"s": "2026-11"}\n
end

case regex/prelude-capture-global
arg -c
filter .s | [capture("(?<d>[0-9])"; "g")]
stdin {"s": "a1b2"}\n
end

case regex/prelude-capture-unmatched
arg -c
filter .s | capture("(?<a>x)?(?<b>y)")
stdin {"s": "y"}\n
end

case regex/prelude-scan
arg -c
filter .s | [scan("c"), scan("(a+)(b)"), scan("A"; "i")]
stdin {"s": "aabcab"}\n
end

case regex/prelude-splits
arg -c
filter .s | [splits(", *")]
stdin {"s": "a, b,c"}\n
end

case regex/prelude-splits-flags
arg -c
filter .s | [splits("X"; "i")]
stdin {"s": "axbXc"}\n
end

case regex/prelude-split-regex
arg -c
filter .s | split(", *"; null)
stdin {"s": "a, b,c"}\n
end

case regex/prelude-split-empty-match
arg -c
filter .s | split(""; null)
stdin {"s": "abc"}\n
end

case regex/prelude-splits-after-empty-match
arg -c
filter .s | [splits("(?<=本)")]
stdin {"s": "日本語"}\n
end

case regex/prelude-offsets-in-code-points
arg -c
filter .s | [match("é+"; "g") | .offset, .length]
stdin {"s": "aééaé"}\n
end

case regex/prelude-argument-order
arg -c
filter .s | [test("a", "c"; null, "g")]
stdin {"s": "ab"}\n
end

case regex/prelude-test-not-string
arg -c
filter .s | try test(1) catch .
stdin {"s": "a"}\n
end

case regex/prelude-match-not-string
arg -c
filter .s | try match(1) catch .
stdin {"s": "a"}\n
end
