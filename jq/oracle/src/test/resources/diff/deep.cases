case deep/hold
arg -c
filter def g: if . == 0 then try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(try(.)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) else (. - 1 | g) end; def f: if . == 0 then 0 else (. - 1 | f) | (1 | g) end; 9999 | f
stdin null\n
end

# M4 (ADR-0046) at depth 10 000: heap/downstream-* of #109 with 10000 for 3. StackUnitsTest runs them across a
# real starter, at the stackBytes that give U_f 1 and U_f 64.

case deep/downstream-error-reenters-the-alt-bind
arg -c
filter def f: if .==0 then ([[1]]|.[] as [$a] ?// $a|$a) else (.-1|f)|. end; [10000|f|if .==1 then error("x") else . end]
stdin null\n
end

case deep/downstream-break-stops-the-forms
arg -c
filter [label $out | def f: if .==0 then (1,2) else (.-1|f)|. end; 10000|f|., break $out]
stdin null\n
end

# Spike A's nested shape (ADR-0011) at n = 2 000: a recursion whose continuation starts a second one 1 000 deep
# at every level; form A ended at 201 drivers. DeepStackFreshJvmTest runs it on a 1 MiB child JVM.

case deep/nested-drivers
arg -c
filter def r: if .==0 then 0 else (.-1|r)+1 end; def n: if .==0 then 0 else (.-1|n)|(1000|r) end; 2000|n
stdin null\n
end

# #113 "Stack calibration" (ADR-0046 and its #113 amendment, K4, D4, F-30, F-95): the calibration shapes that
# #111 did not record, and the 10 000-deep native check. Spike A's T, E, M and N on an array of 10 000 ones; the
# wide body W; the closure chain C; F-30's value-mode [..]|length on the 9 999-deep array; F-95's Collect-heavy
# descent, 300 levels of a call under 100 Collects; and tojson, sort, and sort at every level of a 9 999-deep
# recursion. jq-core CalibrationCell runs each in fresh child JVMs. Required at #113 (require/113.txt).

case deep/shape-t
