# Differential cases (ADR-0020) of #117 "Specialisation" (ADR-0045 "Amendment (ticket #117)", ADR-0006, GLOSSARY
# "Specialisation", "Outside call", "Invariant parameter"): a lifted function's group gets a copy for each outside
# argument tuple of its invariant parameters, so the closures of until, while, recurse(f) and repeat disappear. Every
# case is required at #117 (oracle/src/test/resources/require/117.txt). The 5 000 000-step cases of the design are
# #118's. Format: oracle/src/main/java/io/github/subapavel/jqj/oracle/diff/DiffCase.java. Expected outputs live in
# specialise.rec, written by scripts/oracle-record.sh only. Ids are immutable. Every case uses -c.

# Closed arguments: each prelude loop's closures are closed, so its copy holds no ParamCall.

case specialise/until-closed
arg -c
filter 0|until(.>=3; .+1)
stdin null\n
end

case specialise/while-closed
arg -c
filter [0|while(.<3; .+1)]
stdin null\n
end

case specialise/recurse-closed
arg -c
filter [limit(3; 0|recurse(.+1))]
stdin null\n
end

case specialise/repeat-closed
arg -c
filter [limit(3; 0|repeat(.+1))]
stdin null\n
end

# Over INLINE_CAP: the f0-f15 ladder passes the inline cap, so recurse/1 is a lifted function called PLAIN; it is
# specialised all the same, under its own cap.

case specialise/over-inline-cap-recurse
arg -c
filter def f0: .; def f1: f0|f0; def f2: f1|f1; def f3: f2|f2; def f4: f3|f3; def f5: f4|f4; def f6: f5|f5; def f7: f6|f6; def f8: f7|f7; def f9: f8|f8; def f10: f9|f9; def f11: f10|f10; def f12: f11|f11; def f13: f12|f12; def f14: f13|f13; def f15: f14|f14; f15|f14|f13|f12|f11|f10|f9|f8|f7|f6|f5|f4|f3|f2|f1|f0|f0|f0 | last(limit(30000; 0|recurse(.+1)))
stdin null\n
end

# The same ladder of commas, collected before the recurse runs (#117 re-pin ruling W2): no ladder call is live while
# recurse/1's copy runs its 30 000 levels.

case specialise/over-inline-cap-comma-recurse
arg -c
filter def f0: .; def f1: f0,f0; def f2: f1,f1; def f3: f2,f2; def f4: f3,f3; def f5: f4,f4; def f6: f5,f5; def f7: f6,f6; def f8: f7,f7; def f9: f8,f8; def f10: f9,f9; def f11: f10,f10; def f12: f11,f11; def f13: f12,f12; def f14: f13,f13; def f15: f14,f14; [f15,f14,f13,f12,f11,f10,f9,f8,f7,f6,f5,f4,f3,f2,f1,f0,f0,f0] | last(limit(30000; 0|recurse(.+1)))
stdin null\n
end

# Free references (S4): a slot the argument reads but does not bind becomes a trailing value of the copy.

case specialise/range-3-free-slots-30000
arg -c
filter last(range(0;30000;1))
stdin null\n
end

case specialise/until-free-slot-30000
arg -c
filter 30000 as $n|0|until(.>=$n; .+1)
stdin null\n
end

# A free Break passes its label's token as a trailing value.

case specialise/free-break
arg -c
filter [label $f | 0 | recurse(if . >= 3 then break $f else .+1 end)]
stdin null\n
end

# Literal arguments (S3): constants compare by identity, so the two equal-looking calls get a copy each.

case specialise/literal-arguments
arg -c
filter [limit(2;0|recurse(.+1))],[limit(2;0|recurse(.+1))]
stdin null\n
end

# Order (F-94 "Open", S2): keys are spent in Source order, so param-600's chain of 600 lifted
# definitions, whose demand is above INLINE_CAP, comes before the recurse key; recurse/1 must still get its
# copy. The filter is over-cap/param-600's, then the recurse of over-inline-cap-recurse.

case specialise/order-param-chain-then-recurse
arg -c
filter def g1(f): f; def g2(f): g1(f|.+1); def g3(f): g2(f|.+1); def g4(f): g3(f|.+1); def g5(f): g4(f|.+1); def g6(f): g5(f|.+1); def g7(f): g6(f|.+1); def g8(f): g7(f|.+1); def g9(f): g8(f|.+1); def g10(f): g9(f|.+1); def g11(f): g10(f|.+1); def g12(f): g11(f|.+1); def g13(f): g12(f|.+1); def g14(f): g13(f|.+1); def g15(f): g14(f|.+1); def g16(f): g15(f|.+1); def g17(f): g16(f|.+1); def g18(f): g17(f|.+1); def g19(f): g18(f|.+1); def g20(f): g19(f|.+1); def g21(f): g20(f|.+1); def g22(f): g21(f|.+1); def g23(f): g22(f|.+1); def g24(f): g23(f|.+1); def g25(f): g24(f|.+1); def g26(f): g25(f|.+1); def g27(f): g26(f|.+1); def g28(f): g27(f|.+1); def g29(f): g28(f|.+1); def g30(f): g29(f|.+1); def g31(f): g30(f|.+1); def g32(f): g31(f|.+1); def g33(f): g32(f|.+1); def g34(f): g33(f|.+1); def g35(f): g34(f|.+1); def g36(f): g35(f|.+1); def g37(f): g36(f|.+1); def g38(f): g37(f|.+1); def g39(f): g38(f|.+1); def g40(f): g39(f|.+1); def g41(f): g40(f|.+1); def g42(f): g41(f|.+1); def g43(f): g42(f|.+1); def g44(f): g43(f|.+1); def g45(f): g44(f|.+1); def g46(f): g45(f|.+1); def g47(f): g46(f|.+1); def g48(f): g47(f|.+1); def g49(f): g48(f|.+1); def g50(f): g49(f|.+1); def g51(f): g50(f|.+1); def g52(f): g51(f|.+1); def g53(f): g52(f|.+1); def g54(f): g53(f|.+1); def g55(f): g54(f|.+1); def g56(f): g55(f|.+1); def g57(f): g56(f|.+1); def g58(f): g57(f|.+1); def g59(f): g58(f|.+1); def g60(f): g59(f|.+1); def g61(f): g60(f|.+1); def g62(f): g61(f|.+1); def g63(f): g62(f|.+1); def g64(f): g63(f|.+1); def g65(f): g64(f|.+1); def g66(f): g65(f|.+1); def g67(f): g66(f|.+1); def g68(f): g67(f|.+1); def g69(f): g68(f|.+1); def g70(f): g69(f|.+1); def g71(f): g70(f|.+1); def g72(f): g71(f|.+1); def g73(f): g72(f|.+1); def g74(f): g73(f|.+1); def g75(f): g74(f|.+1); def g76(f): g75(f|.+1); def g77(f): g76(f|.+1); def g78(f): g77(f|.+1); def g79(f): g78(f|.+1); def g80(f): g79(f|.+1); def g81(f): g80(f|.+1); def g82(f): g81(f|.+1); def g83(f): g82(f|.+1); def g84(f): g83(f|.+1); def 