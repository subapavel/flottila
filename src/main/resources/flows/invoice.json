{
  "name": "invoice",
  "from": "http://0.0.0.0:8080/in",
  "concurrency": 16,
  "delivery": "at-least-once",
  "retry": { "attempts": 3, "initialMs": 100, "maxMs": 2000 },
  "persistence": { "batchSize": 100, "batchMs": 10 },
  "steps": [
    { "type": "validate",   "name": "validate",   "required": "/Invoice/Id" },
    { "type": "extractKey", "name": "extractKey", "key": "invoiceId", "xpath": "/Invoice/Id" },
    { "type": "route",      "name": "route",      "prop": "PARTNER",
      "routes": [ { "when": "/Invoice/Currency = 'CZK'", "set": "domestic" } ],
      "otherwise": "foreign" },
    { "type": "xslt",       "name": "toPartner",  "stylesheet": "/flows/invoice-to-partner.xsl" },
    { "type": "to",         "name": "partner",    "byProp": "PARTNER",
      "uri": { "domestic": "http://localhost:8081/echo", "foreign": "http://localhost:8081/echo-foreign" } }
  ]
}
